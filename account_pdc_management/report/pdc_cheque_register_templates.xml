<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- One row per selected cheque, with its status and its bank charge
         recovery if one was raised. Printed from the Post Dated Cheques list. -->
    <template id="report_pdc_cheque_register">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <style>
                        .pdc-reg { width: 100%; border-collapse: collapse; font-size: 12px; }
                        .pdc-reg th, .pdc-reg td { border: 1px solid #999; padding: 4px 6px; }
                        .pdc-reg th { background-color: #e9e9e9; text-align: left; }
                        .pdc-num { text-align: right; white-space: nowrap; }
                        .pdc-title { font-size: 18px; font-weight: bold; margin-bottom: 4px; }
                    </style>

                    <div class="pdc-title">Cheque Register</div>
                    <div class="text-muted mb-3">
                        <span t-field="res_company.name"/> &#8212;
                        printed <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                    </div>

                    <table class="pdc-reg">
                        <thead>
                            <tr>
                                <th>Payment</th>
                                <th>Cheque No</th>
                                <th>Cheque Date</th>
                                <th>Partner</th>
                                <th>Journal</th>
                                <th class="pdc-num">Amount</th>
                                <th>Status</th>
                                <th>Bounce Date</th>
                                <th class="pdc-num">Bank Charge</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="total" t-value="0.0"/>
                            <t t-foreach="docs" t-as="pay">
                                <t t-set="total" t-value="total + pay.amount"/>
                                <t t-set="recovery" t-value="pay.bank_recovery_ids[:1]"/>
                                <tr>
                                    <td><span t-field="pay.name"/></td>
                                    <td><span t-field="pay.cheque_number"/></td>
                                    <td><span t-field="pay.cheque_date"/></td>
                                    <td><span t-field="pay.partner_id.name"/></td>
                                    <td><span t-field="pay.journal_id.name"/></td>
                                    <td class="pdc-num">
                                        <span t-field="pay.amount"
                                              t-options="{'widget': 'monetary', 'display_currency': pay.currency_id}"/>
                                    </td>
                                    <td><span t-field="pay.pdc_state"/></td>
                                    <td><span t-field="pay.pdc_bounce_date"/></td>
                                    <td class="pdc-num">
                                        <t t-if="recovery">
                                            <span t-field="recovery.charge_amount"
                                                  t-options="{'widget': 'monetary', 'display_currency': recovery.currency_id}"/>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="5">Total</th>
                                <th class="pdc-num">
                                    <span t-esc="total"
                                          t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </th>
                                <th colspan="3"/>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
