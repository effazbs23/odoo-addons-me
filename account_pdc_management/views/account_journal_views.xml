<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_journal_form_pdc" model="ir.ui.view">
        <field name="name">account.journal.form.pdc</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='bank_account']" position="before">
                <page string="Post Dated Cheques" name="pdc">
                    <group>
                        <group string="Post Dated Cheques">
                            <field name="is_pdc"/>
                            <field name="pdc_account_id" invisible="not is_pdc"
                                   required="is_pdc"/>
                            <field name="pdc_bank_journal_id" invisible="not is_pdc"/>
                        </group>
                        <group>
                            <div colspan="2" invisible="not is_pdc" class="text-muted">
                                Payments registered in this journal are held in the PDC holding
                                account until the cheque is cleared or bounced. The deposit bank
                                is only the default proposed when clearing a cheque.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_account_journal_tree_pdc" model="ir.ui.view">
        <field name="name">account.journal.list.pdc</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_tree"/>
        <field name="arch" type="xml">
            <field name="type" position="after">
                <field name="is_pdc" optional="show"/>
            </field>
        </field>
    </record>

    <record id="action_pdc_journals" model="ir.actions.act_window">
        <field name="name">PDC Journals</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_pdc', '=', True)]</field>
        <field name="context">{'default_is_pdc': True, 'default_type': 'bank'}</field>
    </record>

</odoo>
