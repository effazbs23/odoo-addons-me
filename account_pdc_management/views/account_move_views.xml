<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_pdc" model="ir.ui.view">
        <field name="name">account.move.form.pdc</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_pdc_payment" type="object" class="oe_stat_button"
                        icon="fa-money" invisible="not pdc_payment_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Post Dated</span>
                        <span class="o_stat_text">Cheque</span>
                    </div>
                </button>
            </div>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="pdc_entry_type" invisible="not pdc_entry_type" readonly="1"/>
                <field name="pdc_payment_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="action_pdc_entries" model="ir.actions.act_window">
        <field name="name">PDC Journal Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('pdc_entry_type', '!=', False)]</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
