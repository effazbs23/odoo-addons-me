<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pdc_bounce_wizard_form" model="ir.ui.view">
        <field name="name">pdc.bounce.wizard.form</field>
        <field name="model">pdc.bounce.wizard</field>
        <field name="arch" type="xml">
            <form string="Bounce Cheque">
                <div class="alert alert-warning" role="alert" invisible="not is_second_bounce">
                    This cheque was already redeposited once. Bouncing it now reverses the
                    redeposit entry, so the two cancel each other out in the ledger.
                </div>
                <p class="text-muted">
                    The amount goes back onto the partner and the cheque is marked as bounced.
                </p>
                <group>
                    <group>
                        <field name="payment_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="is_second_bounce" invisible="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="cheque_number" readonly="1"/>
                        <field name="amount" readonly="1"/>
                    </group>
                    <group>
                        <field name="bounce_date"/>
                        <field name="return_advice" filename="return_advice_filename"
                               widget="binary"/>
                        <field name="return_advice_filename" invisible="1"/>
                    </group>
                </group>
                <group>
                    <field name="bounce_reason" nolabel="1" colspan="2"
                           placeholder="Reason given by the bank, e.g. insufficient funds..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Bounce Cheque"
                            class="btn-danger" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
