<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_amc_update_service_periods" model="ir.cron">
            <field name="name">AMC: Update Service Periods</field>
            <field name="model_id" ref="model_amc_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_service_periods()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">10</field>
        </record>

        <record id="ir_cron_amc_update_expiry_time" model="ir.cron">
            <field name="name">AMC: Update Time To Expiry</field>
            <field name="model_id" ref="model_amc_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_expiry_time()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">11</field>
        </record>

        <record id="ir_cron_amc_expiry_reminder" model="ir.cron">
            <field name="name">AMC: Send Expiry Reminders</field>
            <field name="model_id" ref="model_amc_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_expiry_reminders()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">12</field>
        </record>

    </data>
</odoo>
