#. module: amc_management
#: model:mail.template,body_html:amc_management.mail_template_amc_expiry_reminder
msgid ""
"<div style=\"margin:0px;padding:0px;font-size:13px;\">\n"
"                    <p>Dear <t t-out=\"object.contractor_id.name or ''\">Contractor</t>,</p>\n"
"                    <p>\n"
"                        This is a reminder that the annual maintenance contract below is\n"
"                        approaching its end date.\n"
"                    </p>\n"
"                    <table style=\"border-collapse:collapse;margin:12px 0;\">\n"
"                        <tr>\n"
"                            <td style=\"padding:4px 12px 4px 0;\"><strong>Reference</strong></td>\n"
"                            <td style=\"padding:4px 0;\"><t t-out=\"object.amc_ref or object.name or ''\">AMC-1</t></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding:4px 12px 4px 0;\"><strong>Contract</strong></td>\n"
"                            <td style=\"padding:4px 0;\"><t t-out=\"object.name or ''\">Contract</t></td>\n"
"                        </tr>\n"
"                        <tr t-if=\"object.site_id\">\n"
"                            <td style=\"padding:4px 12px 4px 0;\"><strong>Site</strong></td>\n"
"                            <td style=\"padding:4px 0;\"><t t-out=\"object.site_id.display_name or ''\">Site</t></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding:4px 12px 4px 0;\"><strong>Period</strong></td>\n"
"                            <td style=\"padding:4px 0;\">\n"
"                                <t t-out=\"format_date(object.start_date) or ''\">01/01/2025</t> -\n"
"                                <t t-out=\"format_date(object.end_date) or ''\">31/12/2025</t>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr t-if=\"object.po_id\">\n"
"                            <td style=\"padding:4px 12px 4px 0;\"><strong>Purchase Order</strong></td>\n"
"                            <td style=\"padding:4px 0;\"><t t-out=\"object.po_id.name or ''\">PO0001</t></td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    <p>Please get in touch to arrange the renewal.</p>\n"
"                    <p>Kind regards,<br/><t t-out=\"object.company_id.name or ''\">Company</t></p>\n"
"                </div>\n"
"            "
msgstr ""

