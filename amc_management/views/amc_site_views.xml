<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_amc_site_list" model="ir.ui.view">
        <field name="name">amc.site.list</field>
        <field name="model">amc.site</field>
        <field name="arch" type="xml">
            <list string="AMC Sites">
                <field name="code"/>
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="manager_id" optional="hide"/>
                <field name="analytic_account_id" optional="show"/>
                <field name="contract_count" string="Contracts"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_amc_site_form" model="ir.ui.view">
        <field name="name">amc.site.form</field>
        <field name="model">amc.site</field>
        <field name="arch" type="xml">
            <form string="AMC Site">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_contracts"
                                icon="fa-file-text-o">
                            <field name="contract_count" string="Contracts" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Head Office Tower"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. HQ-01"/>
                            <field name="partner_id"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="analytic_account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_amc_site_search" model="ir.ui.view">
        <field name="name">amc.site.search</field>
        <field name="model">amc.site</field>
        <field name="arch" type="xml">
            <search string="AMC Sites">
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Site Manager" name="group_by_manager"
                            context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_amc_site" model="ir.actions.act_window">
        <field name="name">AMC Sites</field>
        <field name="res_model">amc.site</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
