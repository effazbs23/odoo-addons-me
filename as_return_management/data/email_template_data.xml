<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Return Request Submitted Email Template -->
        <record id="email_template_return_submitted" model="mail.template">
            <field name="name">Return Request Submitted</field>
            <field name="model_id" ref="model_return_request"/>
            <field name="subject">Return Request ${object.name} Submitted</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Hello,</p>
                    <p>A return request has been submitted:</p>
                    <ul>
                        <li><strong>Return Number:</strong> ${object.name}</li>
                        <li><strong>Vendor:</strong> ${object.partner_id.name}</li>
                        <li><strong>Request Date:</strong> ${object.request_date}</li>
                        <li><strong>Total Amount:</strong> ${object.total_return_amount} ${object.currency_id.name}</li>
                    </ul>
                    <p>Please review and approve the return request.</p>
                    <p>Thank you,<br/>Return Management Team</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Return Request Approved Email Template -->
        <record id="email_template_return_approved" model="mail.template">
            <field name="name">Return Request Approved</field>
            <field name="model_id" ref="model_return_request"/>
            <field name="subject">Return Request ${object.name} Approved</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Hello ${object.partner_id.name},</p>
                    <p>Your return request has been approved:</p>
                    <ul>
                        <li><strong>Return Number:</strong> ${object.name}</li>
                        <li><strong>Expected Return Date:</strong> ${object.expected_return_date}</li>
                        <li><strong>Total Amount:</strong> ${object.total_return_amount} ${object.currency_id.name}</li>
                    </ul>
                    <p>We will process your return shortly.</p>
                    <p>Thank you,<br/>Procurement Team</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
