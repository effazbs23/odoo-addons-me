<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Gross Return Form View -->
    <record id="view_gross_return_form" model="ir.ui.view">
        <field name="name">gross.return.form</field>
        <field name="model">return.request</field>
        <field name="arch" type="xml">
            <form string="Gross Return">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary" invisible=" state != 'draft' "/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="as_return_management.group_return_manager"/>
                    <button name="action_done" string="Mark as Done" type="object"
                            class="btn-primary" invisible="state != 'processing'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft','submitted','approved')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,processing,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_return_picking" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                 invisible =" not return_picking_id ">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Return</span>
                                <span class="o_stat_text">Picking</span>
                            </div>
                        </button>
                         <button name="action_view_credit_note" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="  not credit_note_id ">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Credit</span>
                                <span class="o_stat_text">Note</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Hidden field to mark as gross return -->
                    <field name="is_gross_return" invisible="1"/>

                    <group>
                        <group>
                            <field name="partner_id" string="Supplier/Customer"
                                   options="{'no_create': True}"
                                   domain="[('is_customer', '=', True), ('is_supplier', '=', True)]"/>
                            <field name="gross_return_type" required="1"/>
                            <field name="gross_return_source" required="1"/>
                            <field name="warehouse_id" required="1"
                                   options="{'no_create': True}"/>
                            <field name="reference_document"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="gross_return_date"/>
                            <field name="responsible_person"/>
                            <field name="user_id" string="Created By"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Return Items">
                            <field name="return_line_ids" context="{'default_is_gross_return': True}">
                                <list editable="bottom">
                                    <field name="product_id" required="1"/>
                                    <field name="description"/>
                                    <field name="return_qty" required="1"/>
                                    <field name="cost_price" readonly="1"/>
                                    <field name="total_cost" readonly="1" sum="Total Cost"/>
                                    <field name="return_reason" required="1"/>
                                    <field name="return_condition"/>

                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_return_qty"/>
                                <field name="gross_total_cost" string="Total Cost Value"/>
                            </group>
                        </page>
                        <page string="Return Details">
                            <group>
                                <group>
                                    <field name="reason" placeholder="Describe the reason for gross return..."/>
                                </group>
                                <group>
                                    <field name="expected_return_date"/>
                                 </group>
                            </group>
                        </page>

                    </notebook>
                </sheet>
                <Chatter/>
            </form>
        </field>
    </record>

    <!-- Gross Return list View -->
    <record id="view_gross_return_list" model="ir.ui.view">
        <field name="name">gross.return.list</field>
        <field name="model">return.request</field>
        <field name="arch" type="xml">
            <list string="Gross Returns" decoration-info="state=='draft'"
                  decoration-warning="state=='submitted'" decoration-success="state=='done'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="gross_return_type"/>
                <field name="gross_return_source"/>
                <field name="warehouse_id"/>
                <field name="request_date"/>
                <field name="gross_return_date"/>
                <field name="total_return_qty" sum="Total Qty"/>
                <field name="gross_total_cost" sum="Total Cost"/>
                <field name="priority" widget="priority"/>
                <field name="state" decoration-info="state=='draft'"
                       decoration-warning="state=='submitted'" decoration-success="state=='done'"/>
                <field name="user_id"/>
                <!-- Hide regular return fields -->
                <field name="is_gross_return" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Gross Return Kanban View -->
    <record id="view_gross_return_kanban" model="ir.ui.view">
        <field name="name">gross.return.kanban</field>
        <field name="model">return.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="gross_total_cost"/>
                <field name="gross_return_type"/>
                <field name="warehouse_id"/>
                <field name="user_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <field name="priority" widget="priority"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="partner_id"/>
                                <br/>
                                <span class="text-muted">Type: </span>
                                <field name="gross_return_type"/>
                                <br/>
                                <span class="text-muted">Warehouse: </span>
                                <field name="warehouse_id"/>
                                <br/>
                                <span class="text-muted">Cost: </span>
                                <field name="gross_total_cost"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Gross Return Action -->
    <record id="action_gross_return" model="ir.actions.act_window">
        <field name="name">Gross Returns</field>
        <field name="res_model">return.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_gross_return', '=', True)]</field>
        <field name="context">{
            'default_is_gross_return': True,
            'search_default_my_gross_returns': 1
        }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_gross_return_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_gross_return_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_gross_return_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first gross return
            </p>
            <p>
                Manage gross returns for damaged goods, expired products, quality control rejections, and more.
            </p>
        </field>
    </record>
</odoo>
