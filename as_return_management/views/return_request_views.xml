<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Return Request Form View -->
    <record id="view_return_request_form" model="ir.ui.view">
        <field name="name">return.request.form</field>
        <field name="model">return.request</field>
        <field name="arch" type="xml">
            <form string="Sales Return Request">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="oe_highlight" invisible="state !=  'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight" invisible="state != 'submitted'"
                            groups="as_return_management.group_return_manager"/>
                    <button name="action_process" string="Process" type="object"
                            class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_done" string="Done" type="object"
                            class="oe_highlight" invisible="state != 'processing'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft','submitted','approved')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled' "/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,processing,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_return_picking" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible=" not return_picking_id ">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Return</span>
                                <span class="o_stat_text">Receipt</span>
                            </div>
                        </button>
                        <button name="action_view_replacement_picking" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="  not replacement_picking_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Replacement</span>
                                <span class="o_stat_text">Delivery</span>
                            </div>
                        </button>
                        <button name="action_view_credit_note" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="  not credit_note_id ">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Credit</span>
                                <span class="o_stat_text">Note</span>
                            </div>
                        </button>
                        <button name="action_view_replacement_invoice" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible=" not replacement_invoice_id ">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Replacement</span>
                                <span class="o_stat_text">Invoice</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}" domain="[('is_customer', '=', True)]"/>
                            <field name="request_date"/>
                            <field name="expected_return_date"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="return_type" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="invoice_id" required="1"
                                   domain="[('partner_id', '=', partner_id), ('move_type', '=', 'out_invoice'), ('state', '=', 'posted')]"/>
                        </group>
                        <group>
                            <field name="picking_id"
                                   domain="[('partner_id', '=', partner_id), ('picking_type_code', '=', 'outgoing'), ('state', '=', 'done')]"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Return Lines">
                            <field name="return_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="invoiced_qty" readonly="1" force_save="1"/>
                                    <field name="delivered_qty" readonly="1" force_save="1"/>
                                    <field name="available_qty" readonly="1" force_save="1"/>
                                    <field name="return_qty"/>
                                    <field name="replacement_product_id"  />
                                    <field name="replacement_qty"  />
                                    <field name="price_unit" />
                                    <field name="return_reason" optional="show"/>
                                    <field name="return_condition" optional="hide"/>
                                    <field name="action_type"  optional="hide" />
                                    <field name="return_amount" sum="Total Return Amount" />
                                    <field name="replacement_amount" sum="Total Replacement Amount" optional="show"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_return_qty"/>
                                <field name="total_replacement_qty"/>
                                <field name="total_return_amount"/>
                            </group>
                        </page>
                        <page string="Return Reason">
                            <field name="reason" placeholder="Describe the reason for return..."/>
                        </page>
                    </notebook>
                </sheet>
                <Chatter/>
            </form>
        </field>
    </record>

    <!-- Return Request list View -->
    <record id="view_return_request_list" model="ir.ui.view">
        <field name="name">return.request.list</field>
        <field name="model">return.request</field>
        <field name="arch" type="xml">
            <list string="Sales Return Requests" decoration-info="state=='draft'"
                  decoration-warning="state=='submitted'" decoration-success="state=='done'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="request_date"/>
                <field name="return_type"/>
                <field name="total_return_amount" sum="Total Amount"/>
                <field name="priority" widget="priority"/>
                <field name="state" decoration-info="state=='draft'"
                       decoration-warning="state=='submitted'" decoration-success="state=='done'"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>


    <!-- Return Request Kanban View -->
    <record id="view_return_request_kanban" model="ir.ui.view">
        <field name="name">return.request.kanban</field>
        <field name="model">return.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="total_return_amount"/>
                <field name="user_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <field name="priority" widget="priority"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="partner_id"/>
                                <br/>
                                <span class="text-muted">Amount:</span>
                                <field name="total_return_amount"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Return Request Action -->
    <record id="action_return_request" model="ir.actions.act_window">
        <field name="name">Sales Return Requests</field>
        <field name="res_model">return.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('return_operation_type', '!=', 'vendor')]</field>
        <field name="context">{'search_default_my_returns': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_return_request_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_return_request_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_return_request_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first return request
            </p>
            <p>
                Manage product returns and replacements efficiently with our return management system.
            </p>
        </field>
    </record>
</odoo>

