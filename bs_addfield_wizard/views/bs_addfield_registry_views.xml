<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bs_addfield_registry_list" model="ir.ui.view">
        <field name="name">bs.addfield.registry.list</field>
        <field name="model">bs.addfield.registry</field>
        <field name="arch" type="xml">
            <list class="bs_af_list" delete="0">
                <field name="model_label" string="Model"/>
                <field name="model_module" string="App"/>
                <field name="field_label" string="Field Name"/>
                <field name="field_name" string="Technical Name"/>
                <field name="field_type" string="Type"/>
                <field name="notebook_page" string="Tab"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'disabled'"
                       decoration-danger="state == 'deleted'"/>
                <field name="has_data" widget="boolean_toggle" readonly="1"/>
                <button name="action_enable_field" type="object" string="Enable" icon="fa-play"
                        invisible="state != 'disabled'"/>
                <button name="action_disable_field" type="object" string="Disable" icon="fa-pause"
                        invisible="state != 'active' or has_data"/>
                <button name="action_disable_field_confirmed" type="object" string="Disable" icon="fa-pause"
                        invisible="state != 'active' or not has_data"
                        confirm="This field has data on existing records. Disabling it hides it from the form (data is preserved, and it can be re-enabled anytime). Continue?"/>
                <button name="action_open_remove_wizard" type="object" string="Remove" icon="fa-trash"
                        invisible="state == 'deleted'"/>
            </list>
        </field>
    </record>

    <record id="view_bs_addfield_registry_kanban" model="ir.ui.view">
        <field name="name">bs.addfield.registry.kanban</field>
        <field name="model">bs.addfield.registry</field>
        <field name="arch" type="xml">
            <kanban class="bs_af_kanban">
                <field name="state"/>
                <field name="has_data"/>
                <field name="field_type"/>
                <field name="field_label"/>
                <field name="model_label"/>
                <field name="model_module"/>
                <field name="notebook_page"/>
                <templates>
                    <t t-name="card">
                        <div class="bs_af_card oe_kanban_global_click">
                            <div class="bs_af_card_top">
                                <span t-attf-class="bs_af_badge bs_af_badge_#{record.state.raw_value}">
                                    <t t-esc="record.state.value"/>
                                </span>
                                <span class="bs_af_type_tag"><t t-esc="record.field_type.value"/></span>
                            </div>
                            <div class="bs_af_card_title"><t t-esc="record.field_label.value"/></div>
                            <div class="bs_af_card_sub">
                                <t t-esc="record.model_label.value"/>
                                <t t-if="record.model_module.value"> · <t t-esc="record.model_module.value"/></t>
                            </div>
                            <div class="bs_af_card_meta" t-if="record.notebook_page.value">
                                <i class="fa fa-folder-o"/> <t t-esc="record.notebook_page.value"/>
                            </div>
                            <div class="bs_af_card_actions">
                                <button name="action_enable_field" type="object" class="btn btn-sm bs_af_btn_secondary"
                                        invisible="state != 'disabled'">Enable</button>
                                <button name="action_disable_field" type="object" class="btn btn-sm bs_af_btn_secondary"
                                        invisible="state != 'active' or has_data">Disable</button>
                                <button name="action_disable_field_confirmed" type="object" class="btn btn-sm bs_af_btn_secondary"
                                        invisible="state != 'active' or not has_data"
                                        confirm="This field has data on existing records. Disabling it hides it from the form (data is preserved, and it can be re-enabled anytime). Continue?">Disable</button>
                                <button name="action_open_remove_wizard" type="object" class="btn btn-sm bs_af_btn_danger"
                                        invisible="state == 'deleted'">Remove</button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_bs_addfield_registry_form" model="ir.ui.view">
        <field name="name">bs.addfield.registry.form</field>
        <field name="model">bs.addfield.registry</field>
        <field name="arch" type="xml">
            <form class="bs_af_wizard">
                <sheet>
                    <!-- New (unsaved) record: no id yet, redirect straight into the wizard
                         instead of exposing a raw, mostly-readonly registry form. This is how
                         "New" on this list/kanban opens the guided wizard: there is no
                         declarative way to swap what the native New button does, so the New
                         button is left enabled and its blank form immediately offers the
                         wizard launcher instead of empty fields to fill in. -->
                    <div class="bs_af_new_prompt" invisible="id">
                        <p>Use the guided wizard to add a new field.</p>
                        <button name="action_launch_wizard" type="object" string="Launch Wizard"
                                class="btn-primary bs_af_btn"/>
                        <button string="Cancel" special="cancel" class="bs_af_btn_secondary"/>
                    </div>
                    <div invisible="not id">
                        <div class="bs_af_header">
                            <field name="state" nolabel="1" readonly="1" widget="badge"
                                   decoration-success="state == 'active'"
                                   decoration-muted="state == 'disabled'"
                                   decoration-danger="state == 'deleted'"/>
                        </div>
                        <group class="bs_af_group">
                            <field name="model_label"/>
                            <field name="model_module"/>
                            <field name="field_label"/>
                            <field name="field_name"/>
                            <field name="field_type"/>
                            <field name="notebook_page"/>
                            <field name="field_required"/>
                            <field name="has_data"/>
                            <field name="automation_id"/>
                        </group>
                        <div class="bs_af_form_actions">
                            <button name="action_enable_field" type="object" string="Enable"
                                    class="btn-primary bs_af_btn" invisible="state != 'disabled'"/>
                            <button name="action_disable_field" type="object" string="Disable"
                                    class="bs_af_btn_secondary" invisible="state != 'active' or has_data"/>
                            <button name="action_disable_field_confirmed" type="object" string="Disable"
                                    class="bs_af_btn_secondary" invisible="state != 'active' or not has_data"
                                    confirm="This field has data on existing records. Disabling it hides it from the form (data is preserved, and it can be re-enabled anytime). Continue?"/>
                            <button name="action_open_remove_wizard" type="object" string="Remove Field"
                                    class="btn-danger bs_af_btn" invisible="state == 'deleted'"/>
                        </div>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bs_addfield_registry_search" model="ir.ui.view">
        <field name="name">bs.addfield.registry.search</field>
        <field name="model">bs.addfield.registry</field>
        <field name="arch" type="xml">
            <search>
                <field name="field_label"/>
                <field name="model_label"/>
                <filter name="not_deleted" string="Not Deleted" domain="[('state', '!=', 'deleted')]"/>
                <filter name="active_only" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="disabled_only" string="Disabled" domain="[('state', '=', 'disabled')]"/>
                <group>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_label'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="menu_bs_addfield_registry"
              name="Custom Fields Added"
              parent="base.menu_custom"
              action="action_bs_addfield_registry"
              groups="base.group_system"
              sequence="10"/>

</odoo>
