<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_category_form_inherit_amc" model="ir.ui.view">
        <field name="name">product.category.form.inherit.amc</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="AMC" name="amc">
                    <field name="amc_provision_account_id"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
