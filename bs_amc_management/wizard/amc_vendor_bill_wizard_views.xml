<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_amc_vendor_bill_wizard_form" model="ir.ui.view">
        <field name="name">amc.vendor.bill.wizard.form</field>
        <field name="model">amc.vendor.bill.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Vendor Bill">
                <group>
                    <group>
                        <field name="amc_id"/>
                        <field name="po_id"/>
                        <field name="partner_id"/>
                        <field name="site_id" options="{'no_create': True}"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="milestone_number" required="1"/>
                        <field name="milestone_label"/>
                        <field name="quarter_id" options="{'no_create': True}"/>
                        <field name="invoice_date" required="1"/>
                        <field name="bill_amount" required="1"/>
                        <field name="is_advance"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert" invisible="not is_advance">
                    An advance is billed before the service happens, so it carries no service
                    reports. Record the periods the advance covers below; the signed AMC
                    contract is attached automatically.
                </div>
                <group string="Service Periods Covered">
                    <field name="service_period_ids" nolabel="1" colspan="2"
                           options="{'no_create': True, 'no_open': True}">
                        <list create="false" delete="false" edit="false">
                            <field name="name"/>
                            <field name="period_seq" string="Period"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="days_serviced"/>
                            <field name="days_not_serviced"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                    <div colspan="2" class="text-muted">
                        Periods this bill covers. They are linked to the bill for traceability.
                    </div>
                </group>
                <group string="Service Reports to Attach" invisible="is_advance">
                    <field name="service_period_attachment_ids" nolabel="1" colspan="2"
                           options="{'no_create': True, 'no_open': True}">
                        <list create="false" delete="false" edit="false">
                            <field name="name"/>
                            <field name="period_seq" string="Period"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="days_serviced"/>
                            <field name="days_not_serviced"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                    <div colspan="2" class="text-muted">
                        Only Done or Partially Serviced periods can be selected. Their service
                        reports and other attachments are copied onto the bill.
                    </div>
                </group>
                <group string="Remarks">
                    <field name="remarks" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_create_bill" string="Create Vendor Bill" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
