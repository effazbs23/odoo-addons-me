<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_expense_bs_reminder_view" model="ir.ui.view">
        <field name="name">hr.expense.form.bs.reminder</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_bs_snooze_reminder" type="object"
                        string="Snooze Reminder" class="btn-link"
                        invisible="state != 'submitted'"/>
            </xpath>
            <xpath expr="//header/field[@name='state'][1]" position="after">
                <field name="bs_reminder_snoozed_until"
                       readonly="1"
                       invisible="state != 'submitted'"/>
            </xpath>
        </field>
    </record>
</odoo>