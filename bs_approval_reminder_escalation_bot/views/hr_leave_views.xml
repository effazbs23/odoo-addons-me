<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_bs_reminder_view" model="ir.ui.view">
        <field name="name">hr.leave.form.bs.reminder</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_bs_snooze_reminder" type="object"
                        string="Snooze Reminder" class="btn-link"
                        invisible="state != 'confirm' and state != 'validate1'"/>
            </xpath>
            <xpath expr="//header/field[@name='state'][last()]" position="after">
                <field name="bs_reminder_snoozed_until"
                       readonly="1"
                       invisible="state != 'confirm' and state != 'validate1'"/>
            </xpath>
        </field>
    </record>
</odoo>