<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_activity_bs_reminder_tree" model="ir.ui.view">
        <field name="name">mail.activity.bs.reminder.list</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <list string="My Activity Reminders"
                  default_order="date_deadline, id" create="false">
                <header>
                    <button name="action_done" type="object" string="Done" icon="fa-check"/>
                    <button name="action_reschedule_today" type="object" string="Today" icon="fa-arrow-down"/>
                    <button name="action_reschedule_tomorrow" type="object" string="Tomorrow" icon="fa-calendar-plus-o"/>
                    <button name="action_reschedule_nextweek" type="object" string="Next Week" icon="fa-calendar-o"/>
                </header>
                <field name="summary" string="Reminder"/>
                <field name="activity_type_id" string="Type"/>
                <field name="user_id" string="Assigned To"
                       widget="many2one_avatar_user"/>
                <field name="res_name" string="Document"/>
                <field name="date_deadline" string="Deadline"
                       widget="remaining_days"/>
                <field name="res_model_id" column_invisible="1"/>
                <button name="action_done" type="object" string="Done"
                        icon="fa-check" invisible="active == False"/>
            </list>
        </field>
    </record>

    <record id="mail_activity_bs_reminder_search" model="ir.ui.view">
        <field name="name">mail.activity.bs.reminder.search</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <search string="Activity Reminders">
                <field name="res_name" string="Search"
                       filter_domain="['|', ('res_name', 'ilike', self), ('summary', 'ilike', self)]"/>
                <field name="activity_type_id"/>
                <filter name="filter_date_deadline_past" string="Overdue"
                        domain="[('date_deadline', '&lt;', 'today')]"
                        help="Show all records whose reminder deadline is past"/>
                <filter name="filter_date_deadline_today" string="Today"
                        domain="[('date_deadline', '=', 'today')]"/>
                <filter name="filter_date_deadline_future" string="Future"
                        domain="[('date_deadline', '&gt;', 'today')]"/>
                <group>
                    <filter string="Activity Type" name="group_by_type"
                            context="{'group_by': 'activity_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bs_activity_reminder" model="ir.actions.act_window">
        <field name="name">My Reminders</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="mail_activity_bs_reminder_tree"/>
        <field name="search_view_id" ref="mail_activity_bs_reminder_search"/>
        <field name="domain">[('activity_type_id', 'in', [
            ref('bs_approval_reminder_escalation_bot.bs_activity_type_reminder'),
            ref('bs_approval_reminder_escalation_bot.bs_activity_type_escalation'),
        ])]</field>
        <field name="context">{'no_new_document': True, 'default_activity_type_id': ref('bs_approval_reminder_escalation_bot.bs_activity_type_reminder')}</field>
        <field name="help" type="html">
            <p>
                The reminders and escalations waiting on you, grouped by
                deadline. Use the Overdue / Today / Future filters to focus.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_bs_activity_reminder"
        name="My Reminders"
        parent="menu_approval_reminder_config_root"
        action="action_bs_activity_reminder"
        sequence="5"
    />
</odoo>