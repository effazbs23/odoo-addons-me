<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_bs_reminder_view" model="ir.ui.view">
        <field name="name">purchase.order.form.bs.reminder</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_bs_snooze_reminder" type="object"
                        string="Snooze Reminder" class="btn-link"
                        invisible="state != 'to approve'"/>
            </xpath>
            <xpath expr="//header/field[@name='state'][1]" position="after">
                <field name="bs_reminder_snoozed_until"
                       readonly="1"
                       invisible="state != 'to approve'"/>
            </xpath>
        </field>
    </record>
</odoo>