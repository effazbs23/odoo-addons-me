<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_automotive_repair_order" model="ir.sequence">
            <field name="name">Automotive Repair Order</field>
            <field name="code">automotive.repair.order</field>
            <field name="prefix">RO</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_automotive_warranty_claim" model="ir.sequence">
            <field name="name">Automotive Warranty Claim</field>
            <field name="code">automotive.warranty.claim</field>
            <field name="prefix">WC</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_stock_picking_type_repair" model="ir.sequence">
            <field name="name">Repair Order Parts</field>
            <field name="code">stock.picking.repair</field>
            <field name="prefix">RPARTS/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
