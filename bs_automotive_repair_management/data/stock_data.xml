<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Virtual location parts are consumed into once installed on a vehicle,
             mirroring how manufacturing models raw-material consumption instead
             of inventing a new mechanism. -->
        <record id="stock_location_repair_consumption" model="stock.location">
            <field name="name">Repair Order Consumption</field>
            <field name="usage">production</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stock_picking_type_repair" model="stock.picking.type">
            <field name="name">Repair Order Parts</field>
            <field name="code">internal</field>
            <field name="sequence_id" ref="seq_stock_picking_type_repair"/>
            <field name="sequence_code">RPARTS</field>
            <field name="default_location_src_id" ref="stock.stock_location_stock"/>
            <field name="default_location_dest_id" ref="stock_location_repair_consumption"/>
            <field name="company_id" ref="base.main_company"/>
        </record>
    </data>
</odoo>
