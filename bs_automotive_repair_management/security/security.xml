<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_automotive_repair" model="res.groups.privilege">
            <field name="name">Automotive Repair Shop</field>
            <field name="description">Repair order job-card workflow, pricing and warranty management</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_shop_technician" model="res.groups">
            <field name="name">Shop Technician</field>
            <field name="privilege_id" ref="module_category_automotive_repair"/>
            <!-- Parts consumption is a real stock.move/stock.picking under the
                 hood (§2) — technicians need base Inventory rights to create
                 those, or adding a part line fails outright for anyone who
                 isn't already in an Inventory group for unrelated reasons. -->
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_user'))]"/>
        </record>

        <record id="group_shop_salesperson" model="res.groups">
            <field name="name">Shop Salesperson</field>
            <field name="privilege_id" ref="module_category_automotive_repair"/>
            <!-- Invoicing (action_invoice) creates/confirms a sale.order and
                 posts an invoice — needs base Sales rights for the same
                 reason technicians need Inventory rights above. -->
            <field name="implied_ids" eval="[(4, ref('group_shop_technician')), (4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="group_shop_manager" model="res.groups">
            <field name="name">Shop Manager</field>
            <field name="privilege_id" ref="module_category_automotive_repair"/>
            <field name="implied_ids" eval="[(4, ref('group_shop_salesperson'))]"/>
        </record>

        <!-- Technicians only see orders they lead or work on; managers/salespeople see all -->
        <record id="repair_order_technician_rule" model="ir.rule">
            <field name="name">Repair Order — Technician sees own jobs</field>
            <field name="model_id" ref="model_automotive_repair_order"/>
            <field name="domain_force">
                ['|', ('lead_technician_id.user_id', '=', user.id), ('labor_ids.technician_id.user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_shop_technician'))]"/>
        </record>

        <record id="repair_order_salesperson_rule" model="ir.rule">
            <field name="name">Repair Order — Salesperson/Manager sees all</field>
            <field name="model_id" ref="model_automotive_repair_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_shop_salesperson'))]"/>
        </record>

        <record id="repair_order_company_rule" model="ir.rule">
            <field name="name">Repair Order Multi-Company</field>
            <field name="model_id" ref="model_automotive_repair_order"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="vehicle_company_rule" model="ir.rule">
            <field name="name">Vehicle Multi-Company</field>
            <field name="model_id" ref="model_automotive_vehicle"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="warranty_claim_company_rule" model="ir.rule">
            <field name="name">Warranty Claim Multi-Company</field>
            <field name="model_id" ref="model_automotive_warranty_claim"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('origin_repair_order_id.company_id', '=', False),
                      ('origin_repair_order_id.company_id', 'in', company_ids)]
            </field>
        </record>

        <!-- Technicians and salespeople only see the deletion requests they raised;
             group_shop_salesperson implies group_shop_technician so this single rule
             covers both. Managers get an explicit "see all" rule below so they can
             still review everyone's requests despite also holding the technician group. -->
        <record id="deletion_request_technician_rule" model="ir.rule">
            <field name="name">Deletion Request — Technician/Salesperson sees own requests</field>
            <field name="model_id" ref="model_automotive_deletion_request"/>
            <field name="domain_force">[('requested_by', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_shop_technician'))]"/>
        </record>

        <record id="deletion_request_manager_rule" model="ir.rule">
            <field name="name">Deletion Request — Manager sees all</field>
            <field name="model_id" ref="model_automotive_deletion_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_shop_manager'))]"/>
        </record>
    </data>
</odoo>
