<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_automotive_service_catalog_list" model="ir.ui.view">
        <field name="name">automotive.service.catalog.list</field>
        <field name="model">automotive.service.catalog</field>
        <field name="arch" type="xml">
            <list string="Service Catalog" class="o_automotive_repair_bg">
                <field name="name"/>
                <field name="estimated_hours"/>
                <field name="default_hourly_rate" groups="bs_automotive_repair_management.group_shop_manager"/>
            </list>
        </field>
    </record>

    <record id="view_automotive_service_catalog_form" model="ir.ui.view">
        <field name="name">automotive.service.catalog.form</field>
        <field name="model">automotive.service.catalog</field>
        <field name="arch" type="xml">
            <form string="Service" class="o_automotive_repair_bg">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Service Name"/></h1>
                    </div>
                    <group>
                        <field name="estimated_hours"/>
                        <field name="default_hourly_rate" groups="bs_automotive_repair_management.group_shop_manager"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_automotive_service_catalog" model="ir.actions.act_window">
        <field name="name">Service Catalog</field>
        <field name="res_model">automotive.service.catalog</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
