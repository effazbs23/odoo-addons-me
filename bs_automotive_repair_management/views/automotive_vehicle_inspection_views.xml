<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_automotive_vehicle_inspection_list" model="ir.ui.view">
        <field name="name">automotive.vehicle.inspection.list</field>
        <field name="model">automotive.vehicle.inspection</field>
        <field name="arch" type="xml">
            <list string="Vehicle Inspections" class="o_automotive_repair_bg">
                <field name="repair_order_id"/>
                <field name="vehicle_id"/>
                <field name="inspection_type"/>
                <field name="datetime"/>
                <field name="recorded_by"/>
            </list>
        </field>
    </record>

    <record id="view_automotive_vehicle_inspection_form" model="ir.ui.view">
        <field name="name">automotive.vehicle.inspection.form</field>
        <field name="model">automotive.vehicle.inspection</field>
        <field name="arch" type="xml">
            <form string="Vehicle Inspection" class="o_automotive_repair_bg">
                <header>
                    <button name="action_request_deletion" string="Request Deletion" type="object"
                            invisible="user_can_delete_directly"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="repair_order_id"/>
                            <field name="vehicle_id" readonly="1"/>
                            <field name="inspection_type"/>
                            <field name="datetime"/>
                            <field name="recorded_by" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Photos/Videos">
                            <field name="media_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Belongings/Condition">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="returned" widget="boolean_toggle"
                                           column_invisible="parent.inspection_type != 'checkout'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Signature">
                            <group>
                                <field name="signature_full_name"/>
                                <field name="customer_signature" widget="signature"
                                       options="{'full_name': 'signature_full_name'}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_automotive_vehicle_inspection" model="ir.actions.act_window">
        <field name="name">Vehicle Inspections</field>
        <field name="res_model">automotive.vehicle.inspection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
