<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_automotive_vehicle_list" model="ir.ui.view">
        <field name="name">automotive.vehicle.list</field>
        <field name="model">automotive.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles" class="o_automotive_repair_bg">
                <field name="license_plate"/>
                <field name="manufacturer"/>
                <field name="model"/>
                <field name="year"/>
                <field name="partner_id"/>
                <field name="current_mileage"/>
                <field name="repair_order_count"/>
            </list>
        </field>
    </record>

    <record id="view_automotive_vehicle_form" model="ir.ui.view">
        <field name="name">automotive.vehicle.form</field>
        <field name="model">automotive.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle" class="o_automotive_repair_bg">
                <header>
                    <button name="action_request_deletion" string="Request Deletion" type="object"
                            invisible="user_can_delete_directly"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_automotive_repair_order)d" type="action"
                                class="oe_stat_button" icon="fa-wrench"
                                context="{'search_default_vehicle_id': id, 'default_vehicle_id': id}">
                            <field name="repair_order_count" widget="statinfo" string="Repair Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="license_plate" placeholder="License Plate / Chassis No"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="manufacturer"/>
                            <field name="model"/>
                            <field name="year"/>
                            <field name="vin"/>
                        </group>
                        <group>
                            <field name="color"/>
                            <field name="fuel_type"/>
                            <field name="current_mileage"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Service History">
                            <field name="history_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="summary"/>
                                    <field name="total_amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_automotive_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">automotive.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
