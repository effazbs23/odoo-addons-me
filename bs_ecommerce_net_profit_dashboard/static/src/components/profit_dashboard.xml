<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="bs_ecommerce_net_profit_dashboard.BsProfitDashboard">
        <div class="o_action_manager p-4 bg-100 h-100 overflow-auto">
            <h1 class="mb-1">Net Profitability Overview</h1>
            <p class="text-muted mb-4">Track actual COGS, ad spends, channel fees and more — all in one dashboard.</p>
            <div t-if="state.loading" class="text-center p-5"><span class="spinner-border spinner-border-sm"/> Calculating...</div>
            <t t-else="">
                <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
                    <div class="col"><div class="card p-3 border-start border-primary border-4"><h6 class="text-muted">Gross Sales</h6><h3>$<t t-esc="state.metrics.gross_revenue"/></h3></div></div>
                    <div class="col"><div class="card p-3 border-start border-danger border-4"><h6 class="text-muted">Total Drain (COGS + Fees)</h6><h3>$<t t-esc="state.metrics.cogs + state.metrics.channel_fees"/></h3></div></div>
                    <div class="col"><div class="card p-3 border-start border-success border-4"><h6 class="text-muted">Net Profit</h6><h3>$<t t-esc="state.metrics.net_profit"/> <small class="text-success"><t t-esc="state.metrics.margin_ratio"/>% Margin</small></h3></div></div>
                </div>
                <div class="row g-4">
                    <div class="col-md-7">
                        <div class="card p-3 shadow-sm border-0 h-100">
                            <h6 class="mb-3">Profit by Channel</h6>
                            <canvas t-ref="barChart"/>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="card p-3 shadow-sm border-0 h-100">
                            <h6 class="mb-3">Sales Distribution</h6>
                            <canvas t-ref="donutChart"/>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
