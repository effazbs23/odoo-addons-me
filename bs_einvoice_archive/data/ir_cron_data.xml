<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_einvoice_health_check" model="ir.cron">
            <field name="name">E-Invoice Archive: Daily Health Check</field>
            <field name="model_id" ref="model_bs_einvoice_archive"/>
            <field name="state">code</field>
            <field name="code">model._cron_health_check()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_einvoice_drive_upload_queue" model="ir.cron">
            <field name="name">E-Invoice Archive: Google Drive Upload Queue</field>
            <field name="model_id" ref="model_bs_einvoice_drive_upload_queue"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_queue()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
