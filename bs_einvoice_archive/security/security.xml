<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_einvoice_archive" model="res.groups.privilege">
            <field name="name">E-Invoice Archive</field>
            <field name="description">Retention, audit trail, and export of archived e-invoices</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_einvoice_archive_auditor" model="res.groups">
            <field name="name">Auditor</field>
            <field name="privilege_id" ref="module_category_einvoice_archive"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_einvoice_archive_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="module_category_einvoice_archive"/>
            <field name="implied_ids" eval="[(4, ref('group_einvoice_archive_auditor'))]"/>
        </record>

        <!-- Multi-company isolation (global, applies to every user) -->
        <record id="einvoice_archive_company_rule" model="ir.rule">
            <field name="name">E-Invoice Archive Multi-Company</field>
            <field name="model_id" ref="model_bs_einvoice_archive"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="einvoice_retention_policy_company_rule" model="ir.rule">
            <field name="name">E-Invoice Retention Policy Multi-Company</field>
            <field name="model_id" ref="model_bs_einvoice_retention_policy"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="einvoice_drive_config_company_rule" model="ir.rule">
            <field name="name">E-Invoice Drive Config Multi-Company</field>
            <field name="model_id" ref="model_bs_einvoice_drive_config"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
