<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_einvoice_audit_log_list" model="ir.ui.view">
        <field name="name">bs.einvoice.audit.log.list</field>
        <field name="model">bs.einvoice.audit.log</field>
        <field name="arch" type="xml">
            <list string="E-Invoice Audit Log" create="0" edit="0" delete="0">
                <field name="timestamp"/>
                <field name="archive_id"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_einvoice_audit_log_search" model="ir.ui.view">
        <field name="name">bs.einvoice.audit.log.search</field>
        <field name="model">bs.einvoice.audit.log</field>
        <field name="arch" type="xml">
            <search string="Search Audit Log">
                <field name="archive_id"/>
                <field name="user_id"/>
                <field name="action"/>
                <filter name="filter_date" date="timestamp"/>
                <group>
                    <filter name="group_by_archive" string="Archive" context="{'group_by': 'archive_id'}"/>
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_action" string="Action" context="{'group_by': 'action'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_einvoice_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">bs.einvoice.audit.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
