<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Google Cloud OAuth app credentials for the Drive backup feature are
         a single instance-wide pair (same convention as
         google_calendar's cal_client_id/cal_client_secret), so they live in
         General Settings rather than on the per-company drive config
         record. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bs.einvoice.archive</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="E-Invoice Archive" string="E-Invoice Archive"
                     data-key="bs_einvoice_archive" groups="bs_einvoice_archive.group_einvoice_archive_admin">
                    <h2>Google Drive Backup</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="bs_einvoice_drive_client_id" string="Google OAuth Client ID"/>
                                <field name="bs_einvoice_drive_client_id"/>
                                <label for="bs_einvoice_drive_client_secret" string="Google OAuth Client Secret"/>
                                <field name="bs_einvoice_drive_client_secret" password="True"/>
                                <div class="text-muted">
                                    Register an OAuth 2.0 client in Google Cloud Console with the
                                    "drive.file" scope, then connect each company under
                                    E-Invoice Archive &gt; Configuration &gt; Google Drive Backup.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
