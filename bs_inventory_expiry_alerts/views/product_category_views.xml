<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_view_expiry_alert" model="ir.ui.view">
        <field name="name">product.category.form.expiry.alert</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <group name="first" position="inside">
                <field name="expiry_alert_days"/>
            </group>
        </field>
    </record>

    <record id="view_product_category_list_expiry_alert" model="ir.ui.view">
        <field name="name">product.category.list.expiry.alert</field>
        <field name="model">product.category</field>
        <field name="arch" type="xml">
            <list string="Alert Thresholds">
                <field name="expiry_alert_days" string="Days to Alert"/>
                <field name="complete_name" string="Product Category"/>
            </list>
        </field>
    </record>

    <record id="action_product_category_expiry_alert" model="ir.actions.act_window">
        <field name="name">Alert Thresholds</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_product_category_list_expiry_alert"/>
    </record>

    <menuitem id="menu_product_category_expiry_alert"
              parent="stock.menu_stock_warehouse_mgmt"
              name="Alert Thresholds"
              action="action_product_category_expiry_alert"
              sequence="22"/>
</odoo>
