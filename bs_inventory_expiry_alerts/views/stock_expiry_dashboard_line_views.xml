<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_expiry_dashboard_line_list" model="ir.ui.view">
        <field name="name">stock.expiry.dashboard.line.list</field>
        <field name="model">stock.expiry.dashboard.line</field>
        <field name="arch" type="xml">
            <list string="Expiry Dashboard" create="0" edit="0" delete="0"
                  decoration-danger="expiry_bucket == 'expired'"
                  decoration-warning="expiry_bucket == '0_7'">
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="lot_id"/>
                <field name="location_id"/>
                <field name="expiration_date"/>
                <field name="days_to_expiry"/>
                <field name="expiry_bucket"/>
                <field name="quantity"/>
                <field name="suggested_action"/>
                <button name="%(bs_inventory_expiry_alerts.action_stock_expiry_writeoff_wizard)d"
                        type="action" string="Write Off" icon="fa-trash"
                        context="{'default_quant_id': id}"
                        invisible="expiry_bucket != 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_stock_expiry_dashboard_line_search" model="ir.ui.view">
        <field name="name">stock.expiry.dashboard.line.search</field>
        <field name="model">stock.expiry.dashboard.line</field>
        <field name="arch" type="xml">
            <search string="Expiry Dashboard">
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="lot_id"/>
                <field name="categ_id"/>
                <filter name="expired" string="Expired" domain="[('expiry_bucket', '=', 'expired')]"/>
                <filter name="due_0_7" string="0-7 Days" domain="[('expiry_bucket', '=', '0_7')]"/>
                <filter name="due_8_30" string="8-30 Days" domain="[('expiry_bucket', '=', '8_30')]"/>
                <group>
                    <filter name="group_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_bucket" string="Expiry Bucket" context="{'group_by': 'expiry_bucket'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_stock_expiry_dashboard_line_pivot" model="ir.ui.view">
        <field name="name">stock.expiry.dashboard.line.pivot</field>
        <field name="model">stock.expiry.dashboard.line</field>
        <field name="arch" type="xml">
            <pivot string="Expiry Dashboard">
                <field name="warehouse_id" type="row"/>
                <field name="expiry_bucket" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_stock_expiry_dashboard_line" model="ir.actions.act_window">
        <field name="name">Expiry Dashboard</field>
        <field name="res_model">stock.expiry.dashboard.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_expired': 1, 'search_default_due_0_7': 1, 'search_default_due_8_30': 1}</field>
    </record>

    <menuitem id="menu_stock_expiry_dashboard"
              parent="stock.menu_stock_warehouse_mgmt"
              name="Expiry Dashboard"
              action="action_stock_expiry_dashboard_line"
              sequence="20"/>
</odoo>
