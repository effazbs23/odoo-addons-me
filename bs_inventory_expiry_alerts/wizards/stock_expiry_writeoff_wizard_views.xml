<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_expiry_writeoff_wizard_form" model="ir.ui.view">
        <field name="name">stock.expiry.writeoff.wizard.form</field>
        <field name="model">stock.expiry.writeoff.wizard</field>
        <field name="arch" type="xml">
            <form string="Expiry Write-off Assistant">
                <group>
                    <field name="quant_id" invisible="1"/>
                    <field name="product_id"/>
                    <field name="lot_id"/>
                    <field name="location_id"/>
                    <field name="scrap_location_id" domain="[('usage', '=', 'inventory')]"/>
                    <field name="scrap_qty"/>
                    <field name="product_uom_id"/>
                </group>
                <footer>
                    <button name="action_create_writeoff" type="object" string="Write Off"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_expiry_writeoff_wizard" model="ir.actions.act_window">
        <field name="name">Expiry Write-off Assistant</field>
        <field name="res_model">stock.expiry.writeoff.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
