<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Inherit Stock Picking Form: Add Valuation Smart Button
         ============================================================ -->
    <record id="view_picking_form_valuation_button" model="ir.ui.view">
        <field name="name">stock.picking.form.valuation.button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">

                <!-- Valuation smart button -->
                <button
                    name="action_view_picking_valuation"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-usd"
                    invisible="state != 'done' or valued_move_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="valuation_total" widget="monetary"
                                   options="{'currency_field': 'company_currency_id'}"/>
                            <field name="company_currency_id" invisible="1"/>
                        </span>
                        <span class="o_stat_text">Valuation</span>
                    </div>
                </button>

                <!-- Journal Entry smart button -->
                <button
                    name="action_view_valuation_journal_entries"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    invisible="state != 'done' or journal_entry_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="journal_entry_count"/>
                        </span>
                        <span class="o_stat_text">Journal Entries</span>
                    </div>
                </button>

            </div>
            <!-- Hidden fields needed for invisible conditions -->
            <xpath expr="//form/sheet" position="inside">
                <field name="valued_move_count" invisible="1"/>
                <field name="journal_entry_count" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>

