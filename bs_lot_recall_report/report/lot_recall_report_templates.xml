<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_lot_recall_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="doc"/>
            <div class="page">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h2>Lot Recall Report</h2>
                        <p class="text-muted mb-0">Reference: <span t-field="doc.name"/></p>
                    </div>
                    <div class="text-end">
                        <p class="mb-0">Generated on:
                            <span t-field="doc.generated_on"/>
                        </p>
                        <p class="mb-0">Generated by:
                            <span t-field="doc.generated_by.name"/>
                        </p>
                    </div>
                </div>

                <div class="mt-3">
                    <strong>Lots/Serial Numbers traced:</strong>
                    <span t-esc="', '.join(doc.lot_ids.mapped('name'))"/>
                </div>

                <t t-if="doc.forward_line_ids">
                    <h3 class="mt-4">Forward Trace - Customer Deliveries</h3>
                    <p>
                        Customers: <span t-field="doc.forward_customer_count"/> |
                        Sales Orders: <span t-field="doc.forward_sale_order_count"/> |
                        Deliveries: <span t-field="doc.forward_delivery_count"/> |
                        Affected Quantity: <span t-field="doc.forward_quantity"/>
                    </p>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Lot/Serial</th>
                                <th>Customer</th>
                                <th>Sales Order</th>
                                <th>Delivery</th>
                                <th>Quantity</th>
                                <th>UoM</th>
                                <th>Delivery Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.forward_line_ids" t-as="line">
                                <td><span t-field="line.lot_id.name"/></td>
                                <td><span t-field="line.partner_id.name"/></td>
                                <td><span t-field="line.sale_order_id.name"/></td>
                                <td><span t-field="line.delivery_id.name"/></td>
                                <td><span t-field="line.quantity"/></td>
                                <td><span t-field="line.uom_id.name"/></td>
                                <td><span t-field="line.delivery_date"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>

                <t t-if="doc.backward_line_ids">
                    <h3 class="mt-4">Backward Trace - Origin</h3>
                    <p>
                        Vendors: <span t-field="doc.backward_vendor_count"/> |
                        Purchase Orders: <span t-field="doc.backward_purchase_order_count"/> |
                        Manufacturing Orders: <span t-field="doc.backward_production_count"/> |
                        Affected Quantity: <span t-field="doc.backward_quantity"/>
                    </p>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Lot/Serial</th>
                                <th>Type</th>
                                <th>Purchase Order</th>
                                <th>Manufacturing Order</th>
                                <th>Vendor</th>
                                <th>Component Lot</th>
                                <th>Quantity</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.backward_line_ids" t-as="line">
                                <td><span t-field="line.lot_id.name"/></td>
                                <td><span t-field="line.source_type"/></td>
                                <td><span t-field="line.purchase_order_id.name"/></td>
                                <td><span t-field="line.production_id.name"/></td>
                                <td><span t-field="line.partner_id.name"/></td>
                                <td><span t-field="line.component_lot_id.name"/></td>
                                <td><span t-field="line.quantity"/></td>
                                <td><span t-field="line.delivery_date"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>

                <div class="mt-4 p-2" t-attf-class="alert #{'alert-success' if doc.fully_traceable else 'alert-warning'}">
                    <span t-if="doc.fully_traceable">
                        This lot is fully traceable: all upstream and downstream movements have been identified.
                    </span>
                    <span t-else="">
                        No movements were found for one or more of the selected directions.
                    </span>
                </div>
            </div>
        </t>
    </template>

    <template id="report_lot_recall">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="bs_lot_recall_report.report_lot_recall_document"/>
            </t>
        </t>
    </template>
</odoo>
