<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_recall_report" model="ir.module.category">
        <field name="name">Recall Report</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_recall_report" model="res.groups.privilege">
        <field name="name">Recall Report</field>
        <field name="category_id" ref="module_category_recall_report"/>
    </record>

    <record id="group_recall_report_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_recall_report"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_recall_report_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_recall_report"/>
        <field name="implied_ids" eval="[(4, ref('group_recall_report_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="bs_lot_recall_report_rule_multi_company" model="ir.rule">
        <field name="name">Lot Recall Report: multi-company</field>
        <field name="model_id" ref="model_lot_recall_report"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
