<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="analytic_plan_vessels" model="account.analytic.plan">
        <field name="name">Vessels</field>
        <field name="description">Default vessel cost centers for petty cash requests.</field>
    </record>

    <record id="analytic_plan_cost_centers" model="account.analytic.plan">
        <field name="name">Cost Centers</field>
        <field name="description">Default operational cost centers for petty cash requests.</field>
    </record>

    <record id="analytic_account_vessel_general" model="account.analytic.account">
        <field name="name">General Vessel</field>
        <field name="code">VES-GEN</field>
        <field name="plan_id" ref="analytic_plan_vessels"/>
        <field name="company_id" eval="False"/>
    </record>

    <record id="analytic_account_vessel_operations" model="account.analytic.account">
        <field name="name">Vessel Operations</field>
        <field name="code">VES-OPS</field>
        <field name="plan_id" ref="analytic_plan_vessels"/>
        <field name="company_id" eval="False"/>
    </record>

    <record id="analytic_account_admin_cost_center" model="account.analytic.account">
        <field name="name">Administration</field>
        <field name="code">CC-ADMIN</field>
        <field name="plan_id" ref="analytic_plan_cost_centers"/>
        <field name="company_id" eval="False"/>
    </record>

    <record id="analytic_account_operations_cost_center" model="account.analytic.account">
        <field name="name">Operations</field>
        <field name="code">CC-OPS</field>
        <field name="plan_id" ref="analytic_plan_cost_centers"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
