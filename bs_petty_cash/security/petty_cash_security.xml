<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_petty_cash" model="ir.module.category">
        <field name="name">Petty Cash</field>
        <field name="description">Manage petty cash operations</field>
        <field name="sequence">10</field>
    </record>

    <!-- Odoo 19: groups are now organized via res.groups.privilege, not category_id directly -->
    <record id="privilege_petty_cash" model="res.groups.privilege">
        <field name="name">Petty Cash</field>
        <field name="category_id" ref="module_category_petty_cash"/>
    </record>

    <record id="group_petty_cash_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_petty_cash_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="privilege_id" ref="privilege_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('group_petty_cash_user'))]"/>
    </record>

    <record id="group_petty_cash_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('group_petty_cash_cashier'))]"/>
    </record>

    <!-- Record Rules for Portal Users -->
    <!-- Read: a portal user may see all of their own requests, any state. -->
    <record id="petty_cash_request_portal_read_rule" model="ir.rule">
        <field name="name">Portal User: read own Cash Requests</field>
        <field name="model_id" ref="model_petty_cash_request"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <!-- Write/Create: only on their own DRAFT requests, so a submitted or
         approved request can no longer be edited from the portal. -->
    <record id="petty_cash_request_portal_write_rule" model="ir.rule">
        <field name="name">Portal User: edit own draft Cash Requests</field>
        <field name="model_id" ref="model_petty_cash_request"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id), ('state', '=', 'draft')]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="petty_cash_advance_comp_rule" model="ir.rule">
        <field name="name">Petty Cash Advance multi-company</field>
        <field name="model_id" ref="model_petty_cash_advance"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="petty_cash_request_comp_rule" model="ir.rule">
        <field name="name">Petty Cash Request multi-company</field>
        <field name="model_id" ref="model_petty_cash_request" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="petty_cash_settlement_comp_rule" model="ir.rule">
        <field name="name">Petty Cash Settlement multi-company</field>
        <field name="model_id" ref="model_petty_cash_settlement" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Multi-company rules for line models (they carry a stored company_id) -->
    <record id="petty_cash_request_line_comp_rule" model="ir.rule">
        <field name="name">Petty Cash Request Line multi-company</field>
        <field name="model_id" ref="model_petty_cash_request_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="petty_cash_advance_line_comp_rule" model="ir.rule">
        <field name="name">Petty Cash Advance Line multi-company</field>
        <field name="model_id" ref="model_petty_cash_advance_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="petty_cash_settlement_line_comp_rule" model="ir.rule">
        <field name="name">Petty Cash Settlement Line multi-company</field>
        <field name="model_id" ref="model_petty_cash_settlement_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="petty_cash_advance_settlement_line_comp_rule" model="ir.rule">
        <field name="name">Petty Cash Advance Settlement Line multi-company</field>
        <field name="model_id" ref="model_petty_cash_advance_settlement_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
