<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_petty_cash" model="ir.ui.view">
        <field name="name">account.journal.form.petty.cash</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Petty Cash" name="petty_cash" invisible="type != 'cash'">
                    <group>
                        <group>
                            <field name="petty_cash_holder"/>
                        </group>
                        <group>
                            <field name="petty_cash_limit"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
