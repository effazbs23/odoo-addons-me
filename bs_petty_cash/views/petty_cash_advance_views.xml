<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_petty_cash_advance_list" model="ir.ui.view">
        <field name="name">petty.cash.advance.list</field>
        <field name="model">petty.cash.advance</field>
        <field name="arch" type="xml">
            <list >
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="amount"/>
                <field name="balance"/>
                <field name="expected_settlement_date"/>
                <field name="is_returned" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ['approved', 'paid', 'partially_settled']"
                       decoration-success="state == 'settled'"
                       decoration-bf="is_returned == True"/>
            </list>
        </field>
    </record>

    <record id="view_petty_cash_advance_form" model="ir.ui.view">
        <field name="name">petty.cash.advance.form</field>
        <field name="model">petty.cash.advance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve" type="object"
                            invisible="state != 'draft'" class="oe_highlight"
                            groups="petty_cash.group_petty_cash_manager"/>
                    <button name="action_pay" string="Pay" type="object"
                            invisible="state != 'approved'" class="oe_highlight"
                            groups="petty_cash.group_petty_cash_cashier"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ['draft', 'approved']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Returned" bg_color="text-bg-info" invisible="not is_returned"/>
                    <field name="is_returned" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button
                                name="action_open_payment"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-money"
                                invisible="not payment_id">
                            <field name="payment_id" widget="statinfo" string="Payment"/>
                        </button>
                        <button
                                name="action_open_return_journal"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-undo"
                                invisible="not return_move_id">
                            <field name="return_move_id" widget="statinfo" string="Return Entry"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state in ['approved','paid','settled','cancelled']"/>
                            <field name="employee_id" readonly="state in ['approved','paid','settled','cancelled']"/>
                            <field name="request_id" readonly="state in ['approved','paid','settled','cancelled']"/>
                            <field name="create_uid" readonly="1"/>
                            <field name="signed_advance_document" filename="signed_advance_document_name"
                                   invisible="state not in ['approved', 'paid', 'partially_settled', 'settled']"
                                       readonly="state in ['paid', 'partially_settled', 'settled','cancelled']"/>
                            <field name="signed_advance_document_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state in ['approved','paid','settled','cancelled']"/>
                            <field name="vessel_id" readonly="state != 'draft'" string="Cost Center / Vessel"/>
                            <field name="expected_settlement_date" string="Exp. Settlement Date"
                                   readonly="state in ['approved','paid','settled','cancelled']"/>
                            <field name="currency_id" invisible="1" readonly="1"/>
                            <field name="requested_amount" readonly="1" force_save="1"/>
                            <field name="journal_id" readonly="state in ['approved','paid','settled','cancelled']"/>
                            <field name="employee_advance_account_id" string="Advance Account"
                                   readonly="state in ['approved','paid','settled','cancelled']"/>
                            <field name="settled_amount" invisible="state not in ['partially_settled', 'settled']" readonly="1"/>
                            <field name="balance" invisible="state not in ['partially_settled', 'settled']" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Purpose Lines" name="purpose_lines">
                            <field name="line_ids" readonly="state in ['approved','paid','settled','cancelled']">
                                <list editable="bottom">
                                     <field name="purpose" width="50%"/>
                                    <field name="amount" width="50%"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount" widget="monetary" readonly="1" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Settlements" name="settlements" invisible="not settlement_line_ids">
                            <field name="settlement_line_ids" readonly="1">
                                <list>
                                    <field name="settlement_id"/>
                                    <field name="settled_amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="settled_amount" widget="monetary" readonly="1"/>
                                <field name="balance" widget="monetary" readonly="1" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
<!--                    <group>-->
<!--                        <field name="purpose" placeholder="Purpose of advance..."-->
<!--                               readonly="state in ['approved','paid','settled','cancelled']"/>-->
<!--                    </group>-->
                    <group>
                        <field name="notes" placeholder="Additional notes..."
                               readonly="state in ['approved','paid','settled','cancelled']"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_petty_cash_advance" model="ir.actions.act_window">
        <field name="name">Cash Advances</field>
        <field name="res_model">petty.cash.advance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
