<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_petty_cash_request_list" model="ir.ui.view">
        <field name="name">petty.cash.request.list</field>
        <field name="model">petty.cash.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="date" />
                <field name="employee_id" />
                <field name="department_id" />
                <field name="amount" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state=='draft'"
                    decoration-warning="state=='submitted'"
                    decoration-success="state=='approved'"
                />
            </list>
        </field>
    </record>

    <record id="view_petty_cash_request_form" model="ir.ui.view">
        <field name="name">petty.cash.request.form</field>
        <field name="model">petty.cash.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_submit"
                        string="Submit"
                        type="object"
                        invisible="state != 'draft'"
                        class="oe_highlight"
                    />
                    <button
                        name="action_approve"
                        string="Approve"
                        type="object"
                        invisible="state != 'submitted'"
                        class="oe_highlight"
                        groups="petty_cash.group_petty_cash_manager"
                    />
                    <button
                        name="action_reject"
                        string="Reject"
                        type="object"
                        invisible="state != 'submitted'"
                        groups="petty_cash.group_petty_cash_manager"
                    />
                    <button
                        name="action_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state not in ['rejected', 'submitted']"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="employee_id"
                                string="Requested By"
                                readonly="state in ['approved','rejected','issued']"
                            />
                            <field
                                name="department_id"
                                readonly="state in ['approved','rejected','issued']"
                            />
                            <field name="raised_by" readonly="1" />
                            <field name="amount" readonly="1" />
                        </group>
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                readonly="state in ['approved','rejected','issued']"
                            />
                            <field
                                name="vessel_id"
                                readonly="state != 'draft'"
                                string="Cost Center"
                            />
                            <field
                                name="date"
                                readonly="state in ['approved','rejected','issued']"
                            />
                            <field
                                name="currency_id"
                                readonly="state in ['approved','rejected','issued']"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Purpose Lines" name="purpose_lines">
                            <field
                                name="line_ids"
                                readonly="state in ['approved','rejected','issued']"
                            >
                                <list editable="bottom">
                                    <field name="purpose" width="40%" />
                                    <field name="amount" width="30%" />
                                    <field
                                        name="attachment"
                                        filename="attachment_filename"
                                        width="30%"
                                        readonly="parent.state != 'draft'"
                                    />
                                    <field
                                        name="attachment_filename"
                                        column_invisible="1"
                                    />
                                    <field name="currency_id" column_invisible="1" />
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field
                                    name="amount"
                                    widget="monetary"
                                    readonly="1"
                                    class="oe_subtotal_footer_separator"
                                />
                            </group>
                        </page>
                        <page string="Attachments" name="attachments" invisible="1">
                            <field
                                name="attachment_ids"
                                widget="many2many_binary"
                                readonly="state in ['approved','rejected','issued']"
                            />
                        </page>
                    </notebook>
                    <group>
                        <field
                            name="notes"
                            placeholder="Additional notes..."
                            readonly="state in ['approved','rejected','issued']"
                        />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_petty_cash_request" model="ir.actions.act_window">
        <field name="name">Cash Requests</field>
        <field name="res_model">petty.cash.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
