<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_petty_cash_settlement_list" model="ir.ui.view">
        <field name="name">petty.cash.settlement.list</field>
        <field name="model">petty.cash.settlement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="total_amount"/>
                <field name="refund_amount"/>
                <field name="additional_payment"/>
                <field name="state" widget="badge"
                       decoration-info="state=='draft'"
                       decoration-warning="state=='submitted'"
                       decoration-success="state=='posted'"
                />
            </list>
        </field>
    </record>

    <record id="view_petty_cash_settlement_form" model="ir.ui.view">
        <field name="name">petty.cash.settlement.form</field>
        <field name="model">petty.cash.settlement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_post" string="Post" type="object"
                            invisible="state != 'submitted'" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['cancelled', 'posted']"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button
                                name="action_open_journal_entry"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="not move_id">
                            <field name="move_id" widget="statinfo" string="Journal Entry"/>
                        </button>
                        <button
                                name="action_open_payment"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-money"
                                invisible="not payment_id">
                            <field name="payment_id" widget="statinfo" string="Payment"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="settlement_type" readonly="state != 'draft'" widget="radio"/>
                            <field name="settlement_mode" readonly="state != 'draft'" widget="radio"
                                   invisible="settlement_type == 'without_advance'"/>
                            <field name="signed_settlement_document" filename="signed_settlement_document_name"
                                   invisible="state not in ['submitted', 'posted']"
                                   readonly="state == 'posted'"
                                   required="state == 'submitted'"/>
                            <field name="signed_settlement_document_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="vessel_id" readonly="state != 'draft'" string="Cost Center / Vessel"/>
                            <field name="advance_amount" invisible="settlement_type == 'without_advance'"/>
                            <field name="advance_journal_id" required="1" string="Journal"
                                   readonly="state != 'draft' or settlement_type == 'with_advance'"
                                   domain="[('type', '=', 'cash'), ('company_id', '=', company_id)]"/>
                            <field name="employee_advance_account_id" string="Advance Account" invisible="settlement_type == 'without_advance'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Advances to Settle" name="advance_lines" invisible="settlement_type == 'without_advance'">
                            <field name="advance_line_ids" readonly="state not in ['draft', 'submitted']">
                                <list editable="bottom">
                                    <field name="settlement_mode" column_invisible="1"/>
                                    <field name="advance_id"/>
                                    <field name="advance_amount"/>
                                    <field name="advance_balance"/>
                                    <field name="settled_amount" readonly="settlement_mode in ['full', 'return']" force_save="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bills" name="employee_bills" invisible="settlement_mode == 'return'">
                            <group>
                                <field name="available_bill_ids" widget="many2many_tags"
                                       options="{'no_create': True, 'no_open': True}"
                                       invisible="1"
                                       string="Available Bills"/>
                                <field name="tagged_bill_id"
                                       domain="[('id', 'in', available_bill_ids)]"
                                       options="{'no_create': True}" readonly="state not in ['draft', 'submitted']"
                                       string="Bill/Expense for Settlement"
                                       context="{'default_move_type': 'in_invoice'}"/>
                            </group>

                        </page>
                    </notebook>
                    <group>
                        <group>
                            <field name="total_amount" widget="monetary"/>
                        </group>
                        <group>
                            <field name="refund_amount" widget="monetary"
                                   invisible="refund_amount == 0"/>
                            <field name="additional_payment" widget="monetary"
                                   invisible="additional_payment == 0"/>
                        </group>
                    </group>

                    <group>
                        <field name="notes" placeholder="Additional notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_petty_cash_settlement" model="ir.actions.act_window">
        <field name="name">Cash Settlements</field>
        <field name="res_model">petty.cash.settlement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
