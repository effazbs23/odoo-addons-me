<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_stage_task_template_company_rule" model="ir.rule">
        <field name="name">Stage Task Template: multi-company</field>
        <field name="model_id" ref="model_project_stage_task_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="project_stage_task_template_log_company_rule" model="ir.rule">
        <field name="name">Stage Task Template Log: multi-company</field>
        <field name="model_id" ref="model_project_stage_task_template_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
