<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_project_inherit_stage_task_template" model="ir.ui.view">
        <field name="name">project.project.form.inherit.stage.task.template</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_tasks_managment']/div" position="inside">
                <setting class="col-lg-12" id="stage_template_trigger_project_setting"
                         help="Auto-create checklist tasks when this project enters a configured Project Stage">
                    <field name="stage_template_trigger_project"/>
                </setting>
                <setting class="col-lg-12" id="stage_template_trigger_task_setting"
                         help="Auto-create checklist tasks when a task in this project enters a configured Task Stage">
                    <field name="stage_template_trigger_task"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
