<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_inherit_stage_task_template" model="ir.ui.view">
        <field name="name">project.task.form.inherit.stage.task.template</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//h1[field[@name='name']]" position="after">
                <span class="badge text-bg-info align-self-center ms-2 flex-shrink-0" invisible="not generated_from_template_id">
                    <i class="fa fa-magic pe-1"/>Auto-generated
                </span>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="generated_from_template_id" readonly="1" invisible="not generated_from_template_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_task_tree2_inherit_stage_task_template" model="ir.ui.view">
        <field name="name">project.task.list.inherit.stage.task.template</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="generated_from_template_id" optional="hide" string="From Template"/>
            </xpath>
        </field>
    </record>
</odoo>
