<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Return Request Sequence -->
        <record id="seq_return_request" model="ir.sequence">
            <field name="name">Return Request</field>
            <field name="code">return.request</field>
            <field name="prefix">RET</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Vendor Return Request Sequence -->
        <record id="seq_vendor_return_request" model="ir.sequence">
            <field name="name">Vendor Return Request</field>
            <field name="code">vendor.return.request</field>
            <field name="prefix">VRET</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
