<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Return Management Categories -->
        <record id="module_category_return_management" model="res.groups.privilege">
            <field name="name">Return Management</field>
            <field name="description">Manage product returns and replacements</field>
            <field name="sequence">20</field>
        </record>

        <!-- Return User Group -->
        <record id="group_return_user" model="res.groups">
            <field name="name">Return User</field>
            <field name="privilege_id" ref="module_category_return_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Return Manager Group -->
        <record id="group_return_manager" model="res.groups">
            <field name="name">Return Manager</field>
            <field name="privilege_id" ref="module_category_return_management"/>
            <field name="implied_ids" eval="[(4, ref('group_return_user'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="return_request_user_rule" model="ir.rule">
            <field name="name">Return Request User Rule</field>
            <field name="model_id" ref="model_return_request"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_return_user'))]"/>
        </record>

        <record id="return_request_manager_rule" model="ir.rule">
            <field name="name">Return Request Manager Rule</field>
            <field name="model_id" ref="model_return_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_return_manager'))]"/>
        </record>

        <!-- Multi-company isolation (global rules, apply to every user) -->
        <record id="return_request_company_rule" model="ir.rule">
            <field name="name">Return Request Multi-Company</field>
            <field name="model_id" ref="model_return_request"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="return_report_company_rule" model="ir.rule">
            <field name="name">Return Report Multi-Company</field>
            <field name="model_id" ref="model_return_report"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
