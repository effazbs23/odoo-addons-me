    <!-- Return Request Graph View -->
    <record id="view_return_request_graph" model="ir.ui.view">
        <field name="name">return.request.graph</field>
        <field name="model">return.request</field>
        <field name="arch" type="xml">
            <graph string="Return Analysis" type="bar">
                <field name="request_date" type="row" interval="month"/>
                <field name="total_return_amount" type="measure"/>
                <field name="state" type="col"/>
            </graph>
        </field>
    </record>

    <!-- Return Request Pivot View -->
    <record id="view_return_request_pivot" model="ir.ui.view">
        <field name="name">return.request.pivot</field>
        <field name="model">return.request</field>
        <field name="arch" type="xml">
            <pivot string="Return Analysis">
                <field name="partner_id" type="row"/>
                <field name="state" type="col"/>
                <field name="total_return_amount" type="measure"/>
                <field name="total_return_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="action_return_dashboard" model="ir.actions.act_window">
        <field name="name">Return Dashboard</field>
        <field name="res_model">return.request</field>
        <field name="view_mode">graph,pivot</field>
        <field name="context">{}</field>
    </record>
</odoo>
