<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_conflict_guard" model="res.groups.privilege">
            <field name="name">Booking Conflict Guard</field>
            <field name="description">Override double-booking conflict checks</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_conflict_override" model="res.groups">
            <field name="name">Can Override Booking Conflicts</field>
            <field name="privilege_id" ref="module_category_conflict_guard"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Users in this group may confirm "Book Anyway" on a detected
                double-booking conflict instead of being blocked outright.</field>
        </record>
        <!-- Config/log access is restricted to base.group_system via ir.model.access.csv only
             (settings-admin-only) — no row-level ir.rule needed for a single-record/append-only model. -->
    </data>
</odoo>
