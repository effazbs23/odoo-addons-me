<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bs_calendar_conflict_log_list" model="ir.ui.view">
        <field name="name">bs.calendar.conflict.log.list</field>
        <field name="model">bs.calendar.conflict.log</field>
        <field name="arch" type="xml">
            <list string="Conflict Log" create="0" edit="0" delete="0">
                <field name="create_date" string="Date"/>
                <field name="event_id"/>
                <field name="conflicting_event_id"/>
                <field name="resource_type"/>
                <field name="resource_ref"/>
                <field name="action_taken"/>
                <field name="overridden_by"/>
            </list>
        </field>
    </record>

    <record id="action_bs_calendar_conflict_log" model="ir.actions.act_window">
        <field name="name">Conflict Log</field>
        <field name="res_model">bs.calendar.conflict.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_bs_calendar_conflict_log"
              parent="calendar.calendar_menu_config"
              name="Conflict Log"
              action="action_bs_calendar_conflict_log"
              groups="base.group_system"
              sequence="60"/>
</odoo>
