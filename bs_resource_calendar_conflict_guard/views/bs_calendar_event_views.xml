<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_calendar_event_form_inherit_bs_conflict_guard" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.bs.conflict.guard</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <field name="partner_ids" widget="many2manyattendee" position="after">
                <field name="bs_resource_ids" widget="many2many_tags"
                       placeholder="Meeting rooms, equipment..."
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
