<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_simple_invoicing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.simple.invoicing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='default_taxes_setting_container']" position="before">
                <block title="Simple Invoicing" name="simple_invoicing_setting_container">
                    <setting id="simple_invoicing_mode" string="Enable Simple Invoice"
                             help="Show this company's users a reduced Invoicing menu, a simplified invoice form and a plain Draft/Sent/Paid/Overdue status instead of the full Accounting app. Individual users can be added to or removed from the 'Simple Invoicing User' group afterwards to mix simple-mode staff with full-access accountants.">
                        <field name="simple_invoicing_mode"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
