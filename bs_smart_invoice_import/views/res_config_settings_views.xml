<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.quick.paste.order.lines</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting id="quick_paste_llm_setting"
                         string="Invoice AI Extraction"
                         help="Configure the LLM API used to auto-extract order lines from invoice images/PDFs uploaded via Smart Invoice Import">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="quick_paste_llm_base_url" class="col-lg-3 o_light_label"/>
                            <field name="quick_paste_llm_base_url" class="col-lg-7" placeholder="https://api.openai.com/v1"/>
                        </div>
                        <div class="row mt8">
                            <label for="quick_paste_llm_api_key" class="col-lg-3 o_light_label"/>
                            <field name="quick_paste_llm_api_key" class="col-lg-7" password="True"/>
                        </div>
                        <div class="row mt8">
                            <label for="quick_paste_llm_model" class="col-lg-3 o_light_label"/>
                            <field name="quick_paste_llm_model" class="col-lg-7" placeholder="gpt-4o-mini"/>
                        </div>
                        <div class="row mt8">
                            <label for="quick_paste_llm_daily_limit" class="col-lg-3 o_light_label"/>
                            <field name="quick_paste_llm_daily_limit" class="col-lg-7"/>
                        </div>
                        <div class="row mt8">
                            <span class="col-lg-3 o_form_label o_light_label">Extraction Prompt</span>
                            <div class="col-lg-7">
                                <button name="%(bs_smart_invoice_import.action_quick_paste_llm_prompt_wizard)d"
                                        type="action" string="Edit Extraction Prompt"
                                        class="btn-secondary"/>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
