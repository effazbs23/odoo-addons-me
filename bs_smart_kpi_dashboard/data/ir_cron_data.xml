<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- The ONLY automatic discovery trigger, on purpose: hooking
             Apps-UI install/upgrade buttons (ir.module.module) would add
             a full vocabulary scan to every module operation on the
             instance. Modules installed via -i/-u or the Apps UI are
             picked up here within a day; admins can also run discovery
             immediately from the Configuration menu / list-view server
             actions at any time. -->
        <record id="ir_cron_discover_new_models" model="ir.cron">
            <field name="name">Smart KPI Dashboard: Discover New Vocabulary</field>
            <field name="model_id" ref="model_ai_dashboard_allowlist"/>
            <field name="state">code</field>
            <field name="code">model._discover_new_models()
model._discover_new_fields()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
