        <!-- Extra measure phrasings (kept model-distinct on purpose: this
             parser resolves each phrase to exactly one synonym row, so
             reusing the same word across two models would make whichever
             one wins the match arbitrarily override the other, regardless
             of which model the prompt is actually about). -->
        <record id="syn_measure_earnings" model="ai.dashboard.synonym">
            <field name="phrase">earnings</field>
            <field name="slot_type">measure</field>
            <field name="model_id" ref="sale.model_sale_order"/>
