<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": admins curate this vocabulary live (reword a
         phrase, re-prioritize, deactivate) — upgrades must never stomp
         those edits. Ship new phrases as NEW xml ids in future versions. -->
