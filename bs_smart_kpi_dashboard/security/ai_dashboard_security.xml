<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Everyone can SEE their own tiles + anything marked shared;
             write/unlink still separately restricted below to owner-only,
             so a shared tile can't be edited/deleted by non-owners. -->
        <record id="rule_ai_dashboard_tile_read" model="ir.rule">
            <field name="name">Smart KPI Dashboard: see own + shared tiles</field>
            <field name="model_id" ref="model_ai_dashboard_tile"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('shared', '=', True)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_ai_dashboard_tile_write" model="ir.rule">
            <field name="name">Smart KPI Dashboard: only owner may edit/delete</field>
            <field name="model_id" ref="model_ai_dashboard_tile"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

    </data>
</odoo>
