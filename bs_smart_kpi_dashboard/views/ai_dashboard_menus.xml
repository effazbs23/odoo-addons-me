<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The main dashboard itself: an OWL client action -->
    <record id="action_bs_smart_kpi_dashboard" model="ir.actions.client">
        <field name="name">Smart KPI Dashboard</field>
        <field name="tag">bs_smart_kpi_dashboard.dashboard</field>
    </record>

    <menuitem id="menu_bs_smart_kpi_dashboard_root"
              name="Smart KPI Dashboard"
              sequence="60"
              web_icon="bs_smart_kpi_dashboard,static/description/icon.png"/>

    <menuitem id="menu_bs_smart_kpi_dashboard_main"
              name="Dashboard"
              parent="menu_bs_smart_kpi_dashboard_root"
              action="action_bs_smart_kpi_dashboard"
              sequence="10"/>

    <menuitem id="menu_bs_smart_kpi_dashboard_tiles"
              name="Saved Tiles"
              parent="menu_bs_smart_kpi_dashboard_root"
              action="action_ai_dashboard_tile"
              sequence="20"/>

    <menuitem id="menu_bs_smart_kpi_dashboard_config"
              name="Configuration"
              parent="menu_bs_smart_kpi_dashboard_root"
              groups="base.group_system"
              sequence="90"/>

    <menuitem id="menu_bs_smart_kpi_dashboard_allowlist"
              name="Allowed Models"
              parent="menu_bs_smart_kpi_dashboard_config"
              action="action_ai_dashboard_allowlist"
              sequence="10"/>

    <menuitem id="menu_bs_smart_kpi_dashboard_synonyms"
              name="Vocabulary"
              parent="menu_bs_smart_kpi_dashboard_config"
              action="action_ai_dashboard_synonym"
              sequence="20"/>

    <menuitem id="menu_bs_smart_kpi_dashboard_discover"
              name="Discover New Vocabulary"
              parent="menu_bs_smart_kpi_dashboard_config"
              action="action_ai_dashboard_discover_new_models"
              sequence="30"/>

    <menuitem id="menu_bs_smart_kpi_dashboard_unmatched"
              name="Unmatched Prompts"
              parent="menu_bs_smart_kpi_dashboard_config"
              action="action_ai_dashboard_unmatched_phrase"
              sequence="40"/>

    <menuitem id="menu_bs_smart_kpi_dashboard_settings"
              name="Settings"
              parent="menu_bs_smart_kpi_dashboard_config"
              action="action_bs_smart_kpi_dashboard_config_settings"
              sequence="50"/>
</odoo>
