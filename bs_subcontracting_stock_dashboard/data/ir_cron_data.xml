<odoo>
    <record id="ir_cron_subcontracting_overdue_alert" model="ir.cron">
        <field name="name">Subcontracting Stock Dashboard: Overdue Alert</field>
        <field name="model_id" ref="model_subcontracting_stock_report"/>
        <field name="state">code</field>
        <field name="code">model.cron_check_overdue_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
