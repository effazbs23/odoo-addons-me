<odoo>
    <!-- Drill-down (feature 5): reuse native stock.quant / stock.move.line
         list views, pre-filtered to subcontracting locations, rather than
         building a custom read model just to re-display the same records. -->
    <record id="action_subcon_quants" model="ir.actions.act_window">
        <field name="name">Stock Quants at Subcontractors</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('location_id.subcontractor_ids', '!=', False)]</field>
        <field name="context">{'search_default_group_by_owner': 1}</field>
    </record>

    <record id="action_subcon_moves" model="ir.actions.act_window">
        <field name="name">Stock Moves at Subcontractors</field>
        <field name="res_model">stock.move.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('location_id.subcontractor_ids', '!=', False), ('location_dest_id.subcontractor_ids', '!=', False)]</field>
    </record>

    <menuitem id="menu_subcon_drilldown_quants" name="Stock Quants" action="action_subcon_quants"
              parent="menu_subcon_root" sequence="5"/>
    <menuitem id="menu_subcon_drilldown_moves" name="Stock Moves" action="action_subcon_moves"
              parent="menu_subcon_root" sequence="6"/>
</odoo>
