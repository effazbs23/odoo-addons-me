<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bs_search_fuzzy_log_view_list" model="ir.ui.view">
        <field name="name">bs.search.fuzzy.log.view.list</field>
        <field name="model">bs.search.fuzzy.log</field>
        <field name="arch" type="xml">
            <list string="Search Miss Log" create="false" edit="false">
                <field name="create_date" string="Date"/>
                <field name="search_term"/>
                <field name="corrected_term"/>
                <field name="result_count"/>
                <field name="clicked"/>
            </list>
        </field>
    </record>

    <record id="bs_search_fuzzy_log_action" model="ir.actions.act_window">
        <field name="name">Search Miss Log</field>
        <field name="res_model">bs.search.fuzzy.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_search_fuzzy_log"
        name="Search Miss Log"
        action="bs_search_fuzzy_log_action"
        parent="website.menu_reporting"
        groups="website.group_website_designer"
        sequence="40"/>

</odoo>
