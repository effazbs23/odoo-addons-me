<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Production-readiness audit (60.audit.md): bs.notify.log had no record
         rule at all, so access_bs_notify_log_user's unrestricted perm_read=1
         for base.group_user let any internal employee, in any company,
         browse every other company's customer names, phone numbers, order
         and invoice amounts, and message bodies. Verified live: a user in an
         unrelated company with plain "Internal User" rights and zero
         relation to the order could read it before this rule existed.
         Standard company-scoping, matching how sale.order/account.move
         themselves are scoped. -->
    <record id="bs_notify_log_company_rule" model="ir.rule">
        <field name="name">Notification Log: multi-company</field>
        <field name="model_id" ref="model_bs_notify_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
