<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_notify_inherit" model="ir.ui.view">
        <field name="name">account.move.form.notify.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_notify_logs" type="object" class="oe_stat_button" icon="fa-comment"
                        invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="notify_log_count" widget="statinfo" string="Notifications"/>
                </button>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="alert alert-warning" role="alert"
                     invisible="move_type not in ('out_invoice', 'out_refund') or not partner_id or partner_has_valid_notify_number">
                    This customer has no valid mobile number (E.164 format) -- invoice notifications will be skipped.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
