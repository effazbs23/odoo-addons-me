<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bs_notify_gateway_config_list" model="ir.ui.view">
        <field name="name">bs.notify.gateway.config.list</field>
        <field name="model">bs.notify.gateway.config</field>
        <field name="arch" type="xml">
            <list string="Gateway Configuration">
                <field name="channel"/>
                <field name="provider"/>
                <field name="sender_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_bs_notify_gateway_config_form" model="ir.ui.view">
        <field name="name">bs.notify.gateway.config.form</field>
        <field name="model">bs.notify.gateway.config</field>
        <field name="arch" type="xml">
            <form string="Gateway Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="channel"/>
                            <field name="provider"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="sender_id"/>
                            <field name="api_endpoint" placeholder="Required for Generic REST; optional override otherwise"/>
                            <field name="api_key" password="True"/>
                            <field name="api_secret" password="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bs_notify_gateway_config" model="ir.actions.act_window">
        <field name="name">Gateway Configuration</field>
        <field name="res_model">bs.notify.gateway.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
