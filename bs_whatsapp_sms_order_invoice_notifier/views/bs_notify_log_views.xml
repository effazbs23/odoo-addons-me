<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bs_notify_log_list" model="ir.ui.view">
        <field name="name">bs.notify.log.list</field>
        <field name="model">bs.notify.log</field>
        <field name="arch" type="xml">
            <list string="Notification Log" default_order="create_date desc" create="false">
                <field name="create_date" string="Date"/>
                <field name="event_type"/>
                <field name="channel"/>
                <field name="partner_id"/>
                <field name="phone_number"/>
                <field name="source_record_ref"/>
                <field name="status" widget="badge" decoration-success="status == 'sent'"
                       decoration-danger="status == 'failed'" decoration-warning="status == 'skipped_no_phone'"/>
            </list>
        </field>
    </record>

    <record id="view_bs_notify_log_form" model="ir.ui.view">
        <field name="name">bs.notify.log.form</field>
        <field name="model">bs.notify.log</field>
        <field name="arch" type="xml">
            <form string="Notification Log" create="false" edit="false">
                <header>
                    <button name="action_resend" type="object" string="Resend" class="btn-primary"
                            invisible="status == 'sent'" groups="base.group_system"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event_type"/>
                            <field name="channel"/>
                            <field name="status" widget="badge" decoration-success="status == 'sent'"
                                   decoration-danger="status == 'failed'" decoration-warning="status == 'skipped_no_phone'"/>
                            <field name="create_date" string="Date"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="phone_number"/>
                            <field name="source_record_ref"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message_body" nolabel="1"/>
                    </group>
                    <group string="Gateway Response">
                        <field name="provider_response" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bs_notify_log" model="ir.actions.act_window">
        <field name="name">Notification Log</field>
        <field name="res_model">bs.notify.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
