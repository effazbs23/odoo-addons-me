<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_lost_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.lost.form.inherit.win.rate.dashboard</field>
        <field name="model">crm.lead.lost</field>
        <field name="inherit_id" ref="crm.crm_lead_lost_view_form"/>
        <field name="arch" type="xml">
            <field name="lost_reason_id" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <group position="after">
                <group>
                    <field name="lost_note" placeholder="Extra context for the dashboard (optional)" nolabel="1" colspan="2"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
