<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- User Group -->
        <record id="group_lessor_lease_user" model="res.groups">
            <field name="name">Lessor Lease Management / User</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>
        
        <!-- Manager Group -->
        <record id="group_lessor_lease_manager" model="res.groups">
            <field name="name">Lessor Lease Management / Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_lessor_lease_user')), (4, ref('account.group_account_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
