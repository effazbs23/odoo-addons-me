<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Security Group for Lessor Lease Management -->
        <record id="module_category_lessor_lease" model="ir.module.category">
            <field name="name">Lessor Lease Management</field>
            <field name="description">Manage lessor lease contracts and schedules</field>
            <field name="sequence">10</field>
        </record>
        
        <!-- User Group -->
        <record id="group_lessor_lease_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_lessor_lease"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>
        
        <!-- Manager Group -->
        <record id="group_lessor_lease_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_lessor_lease"/>
            <field name="implied_ids" eval="[(4, ref('group_lessor_lease_user')), (4, ref('account.group_account_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
