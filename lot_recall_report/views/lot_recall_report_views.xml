<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lot_recall_report_list" model="ir.ui.view">
        <field name="name">lot.recall.report.list</field>
        <field name="model">lot.recall.report</field>
        <field name="arch" type="xml">
            <list string="Recall Reports">
                <field name="name"/>
                <field name="lot_ids" widget="many2many_tags"/>
                <field name="direction"/>
                <field name="generated_by"/>
                <field name="generated_on"/>
                <field name="state" widget="badge" decoration-success="state == 'generated'"/>
            </list>
        </field>
    </record>

    <record id="view_lot_recall_report_search" model="ir.ui.view">
        <field name="name">lot.recall.report.search</field>
        <field name="model">lot.recall.report</field>
        <field name="arch" type="xml">
            <search string="Recall Reports">
                <field name="name"/>
                <field name="lot_ids"/>
                <field name="generated_by"/>
                <filter string="Generated" name="filter_generated" domain="[('state', '=', 'generated')]"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter string="Direction" name="group_direction" context="{'group_by': 'direction'}"/>
                    <filter string="Generated By" name="group_generated_by" context="{'group_by': 'generated_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_lot_recall_report_form" model="ir.ui.view">
        <field name="name">lot.recall.report.form</field>
        <field name="model">lot.recall.report</field>
        <field name="arch" type="xml">
            <form string="Lot Recall Report" class="o_recall_report_form">
                <header>
                    <button name="action_generate" type="object" string="Generate Recall Report"
                            class="btn-primary" icon="fa-refresh"/>
                    <button name="%(action_report_lot_recall_pdf)d" type="action" string="Export PDF"
                            icon="fa-file-pdf-o" invisible="state != 'generated'"/>
                    <button name="action_export_xlsx" type="object" string="Export XLSX"
                            icon="fa-file-excel-o" invisible="state != 'generated'"/>
                    <button name="action_view_recall_log" type="object" string="Recall Log"
                            icon="fa-list-alt"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Lot Recall Report</span>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="lot_ids" widget="many2many_tags"
                                   options="{'no_create': True}" readonly="state == 'generated'"/>
                            <field name="direction" readonly="state == 'generated'"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="generated_by" readonly="1" invisible="not generated_by"/>
                            <field name="generated_on" readonly="1" invisible="not generated_on"/>
                        </group>
                    </group>

                    <div class="alert alert-info d-flex align-items-center mt-2" role="alert"
                         invisible="state == 'generated'">
                        <i class="fa fa-info-circle fa-lg me-2"/>
                        <span>Use this tool to analyze the impact of this lot/serial across your
                            supply chain and generate an official recall report.</span>
                    </div>

                    <div class="row o_recall_dashboard mt-3" invisible="state != 'generated'">
                        <div class="col-12 col-lg-6 mb-3">
                            <div class="o_recall_card border rounded-3 p-3 h-100">
                                <div class="d-flex justify-content-between align-items-start flex-wrap">
                                    <div class="d-flex align-items-start">
                                        <div class="o_recall_icon o_recall_icon_forward">
                                            <i class="fa fa-arrow-right"/>
                                        </div>
                                        <div class="ms-3">
                                            <h4 class="mb-0">Forward Trace</h4>
                                            <span class="text-muted">Where this lot has been delivered
                                                (Customers, Sales Orders, Deliveries)</span>
                                        </div>
                                    </div>
                                    <div class="o_recall_stat o_recall_stat_danger text-end">
                                        <span class="d-block small text-muted">Affected Quantity</span>
                                        <field name="forward_quantity" readonly="1" class="fw-bold fs-4"/>
                                    </div>
                                </div>
                                <div class="row mt-3 g-2">
                                    <div class="col-4">
                                        <div class="o_recall_metric">
                                            <i class="fa fa-users"/>
                                            <div>
                                                <field name="forward_customer_count" readonly="1" class="fw-bold d-block"/>
                                                <span class="text-muted small">Customers received this lot</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="o_recall_metric">
                                            <i class="fa fa-file-text-o"/>
                                            <div>
                                                <field name="forward_sale_order_count" readonly="1" class="fw-bold d-block"/>
                                                <span class="text-muted small">Sales orders including this lot</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="o_recall_metric">
                                            <i class="fa fa-truck"/>
                                            <div>
                                                <field name="forward_delivery_count" readonly="1" class="fw-bold d-block"/>
                                                <span class="text-muted small">Deliveries completed with this lot</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <h6 class="mt-3">Customer Deliveries</h6>
                                <field name="forward_line_ids" readonly="1" nolabel="1">
                                    <list create="false" edit="false" delete="false">
                                        <field name="partner_id" string="Customer"/>
                                        <field name="sale_order_id" string="Sales Order"/>
                                        <field name="delivery_id" string="Delivery"/>
                                        <field name="quantity"/>
                                        <field name="uom_id" string="UoM"/>
                                        <field name="delivery_date" string="Delivery Date"/>
                                    </list>
                                </field>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 mb-3">
                            <div class="o_recall_card border rounded-3 p-3 h-100">
                                <div class="d-flex justify-content-between align-items-start flex-wrap">
                                    <div class="d-flex align-items-start">
                                        <div class="o_recall_icon o_recall_icon_backward">
                                            <i class="fa fa-arrow-left"/>
                                        </div>
                                        <div class="ms-3">
                                            <h4 class="mb-0">Backward Trace</h4>
                                            <span class="text-muted">Where this lot came from
                                                (Vendors, Purchase Orders, Manufacturing)</span>
                                        </div>
                                    </div>
                                    <div class="o_recall_stat o_recall_stat_primary text-end">
                                        <span class="d-block small text-muted">Affected Quantity</span>
                                        <field name="backward_quantity" readonly="1" class="fw-bold fs-4"/>
                                    </div>
                                </div>
                                <div class="row mt-3 g-2">
                                    <div class="col-4">
                                        <div class="o_recall_metric">
                                            <i class="fa fa-truck"/>
                                            <div>
                                                <field name="backward_vendor_count" readonly="1" class="fw-bold d-block"/>
                                                <span class="text-muted small">Vendor(s) supplied this lot</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="o_recall_metric">
                                            <i class="fa fa-file-text-o"/>
                                            <div>
                                                <field name="backward_purchase_order_count" readonly="1" class="fw-bold d-block"/>
                                                <span class="text-muted small">Purchase orders for this lot</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="o_recall_metric">
                                            <i class="fa fa-industry"/>
                                            <div>
                                                <field name="backward_production_count" readonly="1" class="fw-bold d-block"/>
                                                <span class="text-muted small">Manufacturing orders produced this lot</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <h6 class="mt-3">Origin</h6>
                                <field name="backward_line_ids" readonly="1" nolabel="1">
                                    <list create="false" edit="false" delete="false">
                                        <field name="source_type" string="Type"/>
                                        <field name="purchase_order_id" string="Purchase Order"/>
                                        <field name="production_id" string="Manufacturing Order"/>
                                        <field name="partner_id" string="Vendor"/>
                                        <field name="component_lot_id" string="Component Lot"/>
                                        <field name="quantity"/>
                                        <field name="delivery_date" string="Date"/>
                                    </list>
                                </field>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-success d-flex align-items-center mt-2"
                         invisible="state != 'generated' or not fully_traceable">
                        <i class="fa fa-check-circle fa-lg me-2"/>
                        <span>This lot is fully traceable: all upstream and downstream movements have
                            been identified.</span>
                    </div>
                    <div class="alert alert-warning d-flex align-items-center mt-2"
                         invisible="state != 'generated' or fully_traceable">
                        <i class="fa fa-exclamation-triangle fa-lg me-2"/>
                        <span>No movements were found for one or more of the selected directions.
                            Review the lot's stock moves before relying on this report.</span>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_lot_recall_report" model="ir.actions.act_window">
        <field name="name">Recall Reports</field>
        <field name="res_model">lot.recall.report</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Generate a recall report from a lot/serial number to see its
                full forward and backward traceability.
            </p>
        </field>
    </record>
</odoo>
