<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_auto_schedule_wizard_form" model="ir.ui.view">
        <field name="name">mrp.auto.schedule.wizard.form</field>
        <field name="model">mrp.auto.schedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Auto-schedule Work Orders">
                <p class="text-muted">
                    Places the selected work orders into the earliest available
                    capacity slot on their workcenter, prioritizing manufacturing
                    orders with the closest due date.
                </p>
                <field name="work_order_ids">
                    <list>
                        <field name="production_id"/>
                        <field name="workcenter_id"/>
                        <field name="duration_expected"/>
                        <field name="state"/>
                    </list>
                </field>
                <footer>
                    <button name="action_auto_schedule" type="object"
                            string="Auto-schedule" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mrp_auto_schedule_wizard" model="ir.actions.act_window">
        <field name="name">Auto-schedule</field>
        <field name="res_model">mrp.auto.schedule.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
