<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mrp_production_intercompany_link_list" model="ir.ui.view">
        <field name="name">mrp.production.intercompany.link.list</field>
        <field name="model">mrp.production.intercompany.link</field>
        <field name="arch" type="xml">
            <list string="Intercompany Supply Links" create="false"
                  decoration-danger="state == 'failed'" decoration-muted="state == 'done'">
                <field name="parent_production_id"/>
                <field name="parent_company_id"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="child_company_id"/>
                <field name="child_production_id"/>
                <field name="purchase_order_id"/>
                <field name="sale_order_id"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'failed'"
                       decoration-success="state == 'done'"/>
                <field name="progress_percentage" widget="progressbar"/>
                <field name="has_due_date_exception" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_mrp_production_intercompany_link_form" model="ir.ui.view">
        <field name="name">mrp.production.intercompany.link.form</field>
        <field name="model">mrp.production.intercompany.link</field>
        <field name="arch" type="xml">
            <form string="Intercompany Supply Link" create="false">
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_view_child_production" type="object"
                            string="View Child MO" invisible="not child_production_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="po_created,so_confirmed,mo_created,done"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not has_due_date_exception">
                        <field name="exception_message" nolabel="1" readonly="1"/>
                    </div>
                    <field name="status_display" nolabel="1" readonly="1" class="oe_inline"/>
                    <group>
                        <group string="Component">
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="progress_percentage" widget="progressbar"/>
                        </group>
                        <group string="Companies">
                            <field name="parent_company_id"/>
                            <field name="child_company_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Parent (Company A)">
                            <field name="parent_production_id"/>
                        </group>
                        <group string="Child (Company B)">
                            <field name="child_production_id"/>
                        </group>
                    </group>
                    <group string="Pipeline">
                        <field name="sale_order_id"/>
                        <field name="purchase_order_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mrp_production_intercompany_link_search" model="ir.ui.view">
        <field name="name">mrp.production.intercompany.link.search</field>
        <field name="model">mrp.production.intercompany.link</field>
        <field name="arch" type="xml">
            <search string="Search Intercompany Supply Links">
                <field name="parent_production_id"/>
                <field name="child_production_id"/>
                <field name="product_id"/>
                <filter string="Exceptions" name="filter_exceptions" domain="[('has_due_date_exception', '=', True)]"/>
                <filter string="Failed" name="filter_failed" domain="[('state', '=', 'failed')]"/>
                <filter string="Open" name="filter_open" domain="[('state', 'not in', ('done', 'failed'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Supplying Company" name="group_child_company" context="{'group_by': 'child_company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mrp_production_intercompany_link" model="ir.actions.act_window">
        <field name="name">Intercompany Supply Links</field>
        <field name="res_model">mrp.production.intercompany.link</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No intercompany supply links yet.
            </p>
            <p>
                A link appears here whenever a manufacturing order needs a
                component flagged as "Produced By Company" a different
                company in this database, and this module raised an
                intercompany purchase order for it.
            </p>
        </field>
    </record>

</odoo>
