<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- `mrp.mrp_production_form_view` verified against the real
         odoo/odoo 19.0 source (addons/mrp/views/mrp_production_views.xml);
         the `//header` and `//notebook` xpaths target structural elements
         present on every Odoo form view of this kind. -->
    <record id="view_mrp_production_form_intercompany" model="ir.ui.view">
        <field name="name">mrp.production.form.intercompany.wo.sync</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="has_intercompany_supply" invisible="1"/>
                <button name="action_create_intercompany_supply" type="object"
                        string="Check Intercompany Supply"
                        class="btn-secondary"
                        invisible="not has_intercompany_supply"
                        groups="mrp.group_mrp_user"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Intercompany Supply" name="intercompany_supply"
                      invisible="not intercompany_link_ids and not as_child_intercompany_link_id">
                    <div class="alert alert-info" role="alert"
                         invisible="not intercompany_status_display">
                        <field name="intercompany_status_display" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not has_intercompany_due_date_exception">
                        <strong><i class="fa fa-exclamation-triangle"/> Due-Date Exception</strong>
                        <field name="intercompany_exception_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="row" invisible="not intercompany_link_ids">
                        <div class="col-6">
                            <group string="Company A - Parent Manufacturing Order">
                                <field name="name" readonly="1"/>
                                <field name="product_id" readonly="1"/>
                                <field name="product_qty" readonly="1"/>
                                <field name="company_id" readonly="1"/>
                                <field name="date_deadline" readonly="1"/>
                                <field name="date_start" readonly="1"/>
                            </group>
                        </div>
                        <div class="col-6">
                            <group string="Pipeline">
                                <p class="text-muted">
                                    Sales Order &#8594; Purchase Order &#8594; Child Manufacturing Order.
                                    See the table below for each component's reference and status.
                                </p>
                            </group>
                        </div>
                    </div>
                    <group string="Company B - Supplied Via" invisible="not as_child_intercompany_link_id">
                        <field name="as_child_intercompany_link_id" readonly="1" string="Intercompany Link"/>
                    </group>
                    <field name="intercompany_link_ids" readonly="1" invisible="not intercompany_link_ids">
                        <list>
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="child_company_id"/>
                            <field name="purchase_order_id"/>
                            <field name="sale_order_id"/>
                            <field name="child_production_id"/>
                            <field name="state" widget="badge"
                                   decoration-danger="state == 'failed'"
                                   decoration-success="state == 'done'"
                                   decoration-info="state in ('po_created', 'so_confirmed', 'mo_created')"/>
                            <field name="progress_percentage" widget="progressbar"/>
                            <field name="has_due_date_exception" widget="boolean_toggle" readonly="1"/>
                            <button name="action_view_child_production" type="object"
                                    string="View Child MO" icon="fa-external-link"
                                    invisible="not child_production_id"/>
                            <button name="action_retry" type="object"
                                    string="Retry" icon="fa-refresh"
                                    invisible="state == 'done'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
