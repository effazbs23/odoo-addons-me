<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Verified against the real odoo/odoo 19.0 source
         (addons/product/views/product_views.xml): the base
         `product.product_template_form_view` (not the more specific
         `product_template_only_form_view`) defines `group[@name='purchase']`,
         exactly as targeted below. -->
    <record id="view_product_template_form_intercompany" model="ir.ui.view">
        <field name="name">product.template.form.intercompany.wo.sync</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="purchase" position="inside">
                <field name="intercompany_manufacturer_id"/>
            </group>
        </field>
    </record>

</odoo>
