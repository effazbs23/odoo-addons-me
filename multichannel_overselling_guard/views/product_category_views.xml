<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- product.product_category_form_view and its `parent_id` field
         verified against the real odoo/odoo 19.0 source
         (addons/product/views/product_category_views.xml). -->
    <record id="view_product_category_form_inherit_multichannel" model="ir.ui.view">
        <field name="name">product.category.form.inherit.multichannel.overselling.guard</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="overselling_guard_enabled"/>
                <field name="default_reserved_buffer_qty"
                       invisible="not overselling_guard_enabled"/>
            </field>
        </field>
    </record>

</odoo>
