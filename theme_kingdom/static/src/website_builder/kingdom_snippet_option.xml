<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="theme_kingdom.KingdomSnippetOption">
        <t t-if="this.configAction">
            <BuilderRow label.translate="Configuration">
                <BuilderButton type="'secondary'"
                               preview="false"
                               action="'openKingdomSnippetConfig'"
                               actionParam="{ actionXmlId: this.configAction }">
                    Configure
                </BuilderButton>
            </BuilderRow>
        </t>
        <BuilderRow label.translate="Block">
            <BuilderButton type="'danger'"
                           preview="false"
                           action="'removeKingdomSnippetBlock'"
                           title.translate="Remove this block from the page"
                           icon="'fa-trash'">
                Remove block
            </BuilderButton>
        </BuilderRow>
    </t>

    <t t-name="theme_kingdom.KingdomCarouselSlideOption">
        <div class="px-2 pb-2 small text-muted">
            Use the arrows above to add or remove individual slides.
            To delete the whole slider, remove the parent block below.
        </div>
        <BuilderRow label.translate="Block">
            <BuilderButton type="'danger'"
                           preview="false"
                           action="'removeKingdomSnippetBlock'"
                           title.translate="Remove the entire slider block"
                           icon="'fa-trash'">
                Remove slider block
            </BuilderButton>
        </BuilderRow>
    </t>

</templates>
