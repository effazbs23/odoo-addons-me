<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bestsale_products_list" model="ir.ui.view">
        <field name="name">bestsale.products.list</field>
        <field name="model">bestsale.products</field>
        <field name="arch" type="xml">
            <list string="Best Sale Products">
                <field name="name"/>
                <field name="product_tmpl_ids"/>
            </list>
        </field>
    </record>

    <record id="view_bestsale_products_form" model="ir.ui.view">
        <field name="name">bestsale.products.form</field>
        <field name="model">bestsale.products</field>
        <field name="arch" type="xml">
            <form string="Best Sale Products">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group string="Products">
                        <field name="product_tmpl_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bestsale_products" model="ir.actions.act_window">
        <field name="name">Best Sale Products</field>
        <field name="res_model">bestsale.products</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_bestsale_products"
              name="Best Sale Products"
              parent="website.menu_website_global_configuration"
              action="action_bestsale_products"
              sequence="53"/>

</odoo>
