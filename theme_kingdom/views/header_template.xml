<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="kingdom_layout_wrapper"
              inherit_id="website.layout"
              name="Kingdom Layout Wrapper">
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="class" add="master-wrapper-page" separator=" "/>
        </xpath>
    </template>

    <template id="kingdom_header_category_item" name="Kingdom Header Category Item">
        <t t-set="category_children" t-value="category.kingdom_get_header_children()"/>
        <li t-attf-class="mm-nav-item #{category_children and 'has-children' or ''}">
            <a t-att-href="'/shop/category/%s' % category.id"
               t-attf-class="#{category_children and 'mm-nav-image' or ''}">
                <span class="nav-icon">
                    <img class="image-container"
                         t-att-src="category.image_128 and '/web/image/product.public.category/%s/image_128' % category.id or '/theme_kingdom/static/src/images/content/placeholder.svg'"
                         t-att-alt="category.name"
                         width="40"
                         height="32"
                         loading="lazy"/>
                </span>
                <span class="category-name" t-out="category.name"/>
                <span t-if="category_children" class="right-arrow icon icon-right-arrow" aria-hidden="true"/>
            </a>
            <div t-if="category_children" class="sublist">
                <ul class="sublist-list ps-0 mb-0">
                    <li t-foreach="category_children" t-as="child" class="mm-nav-item">
                        <a t-att-href="'/shop/category/%s' % child.id">
                            <span class="category-name" t-out="child.name"/>
                        </a>
                    </li>
                </ul>
            </div>
        </li>
    </template>

    <template id="kingdom_header_menu_item" name="Kingdom Header Menu Item">
        <t t-set="submenus" t-value="menu_item.child_id"/>
        <li t-attf-class="mm-nav-item #{submenus and 'has-children' or ''}">
            <a t-att-href="menu_item.url or '#'">
                <span class="category-name" t-out="menu_item.name"/>
                <span t-if="submenus" class="right-arrow icon icon-right-arrow" aria-hidden="true"/>
            </a>
            <div t-if="submenus" class="sublist">
                <ul class="sublist-list ps-0 mb-0">
                    <li t-foreach="submenus" t-as="submenu" class="mm-nav-item">
                        <a t-att-href="submenu.url or '#'">
                            <span class="category-name" t-out="submenu.name"/>
                        </a>
                    </li>
                </ul>
            </div>
        </li>
    </template>

    <template id="kingdom_header"
              inherit_id="website.layout"
              name="Kingdom Header"
              priority="99">

        <xpath expr="//header" position="replace">
            <t t-set="website_sale_cart" t-value="request.cart"/>
            <t t-set="website_sale_cart_quantity" t-value="website_sale_cart.cart_quantity if website_sale_cart else 0"/>
            <t t-set="wishcount" t-value="len(request.env['product.wishlist'].current())"/>
            <t t-set="kingdom_root_categories" t-value="request.env['product.public.category'].kingdom_get_header_roots()"/>
            <t t-set="kingdom_top_menus" t-value="website.menu_id.child_id"/>
            <t t-set="active_lang" t-value="frontend_languages.get(lang) if frontend_languages else None"/>
            <t t-set="pricelist" t-value="request.pricelist"/>
            <t t-set="website_sale_pricelists" t-value="website.get_pricelist_available(show_visible=True)"/>
            <t t-set="hasPricelistDropdown" t-value="website_sale_pricelists and len(website_sale_pricelists) &gt; 1"/>
            <t t-set="kingdom_cart_amount" t-value="website_sale_cart.amount_total if website_sale_cart else 0.0"/>
            <t t-set="is_logged_in" t-value="website.user_id != user_id"/>

            <div class="master-header">
                <div class="master-header-panel">
                    <div class="announcement-bar announcement-wrapper announcement-open announcement-desktop position-relative"
                         id="AnnouncementBanner"
                         role="region"
                         aria-label="Announcement">

                        <div id="announcement-slider" class="swiper swiper-fade" dir="ltr">
                            <div class="swiper-wrapper">
                                <div class="swiper-slide" role="group" aria-label="1 / 1">
                                    <span class="announcement-item">
                                        <span class="announcement-title">
                                            Up to 25% off Every Friday &amp; Saturday
                                        </span>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <button type="button" id="announcement-close" aria-label="Close announcement">
                            <i class="icon icon-close" aria-hidden="true"/>
                        </button>

                        <button type="button" id="announcement-minimize" aria-label="Minimize or expand announcement">
                            <i class="icon icon-down-arrow" aria-hidden="true"/>
                        </button>
                    </div>

            <div class="header header-main o_colored_level" id="top" data-name="Header">
                <div class="header-lower">
                    <button type="button"
                            class="btn btn-link mobile-menu-trigger d-lg-none p-0 me-1 border-0"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#MobileNavigationDrawer"
                            aria-controls="MobileNavigationDrawer"
                            aria-label="Open menu">
                        <svg class="mobile-menu-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
                        </svg>
                    </button>

                    <div class="header-logo">
                        <a href="/" class="k-logo k-logo-brand d-inline-block text-start" t-att-aria-label="website.name">
                            <img t-att-src="'/logo.png?company=%s' % res_company.id"
                                 t-att-alt="website.name"
                                 loading="eager"/>
                        </a>
                    </div>

                    <div class="search-box search-box-main search-box-desktop">
                        <form method="get"
                              action="/shop"
                              role="search"
                              class="o_searchbar_form s_searchbar_input"
                              data-snippet="s_searchbar_input">
                            <input type="hidden" class="o_search_order_by oe_unremovable" name="order" value="name asc"/>
                            <label class="visually-hidden" for="kSearchQuery">Search store</label>
                            <input id="kSearchQuery"
                                   type="search"
                                   name="search"
                                   class="search-query"
                                   data-search-type="products"
                                   data-limit="5"
                                   data-display-image="true"
                                   data-display-description="true"
                                   data-display-extra-link="true"
                                   data-display-detail="true"
                                   placeholder="Search store"
                                   autocomplete="off"/>
                            <button type="submit" class="button-1 search-box-button" title="Search" aria-label="Search"/>
                        </form>
                    </div>

                    <div class="header-lower-right">
                        <div class="header-selectors-wrapper">
                            <div class="header-terms header-link-top">
                                <a href="/terms"><i class="bi bi-asterisk" aria-hidden="true"/><span>Terms &amp; conditions</span></a>
                            </div>
                            <div class="header-storelocation header-link-top">
                                <a href="/contactus"><i class="bi bi-person" aria-hidden="true"/><span>Contact Us</span></a>
                            </div>
                            <div class="header-inline-selectors" aria-label="Store selectors">
                                <t t-if="hasPricelistDropdown">
                                    <div class="dropdown d-inline-block">
                                        <a href="#"
                                           class="k-inline-select dropdown-toggle"
                                           data-bs-toggle="dropdown"
                                           aria-label="Currency">
                                            <span t-out="pricelist and pricelist.name or 'Pricelist'"/>
                                            <i class="bi bi-chevron-down" aria-hidden="true"/>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-end">
                                            <a t-foreach="website_sale_pricelists"
                                               t-as="pl"
                                               role="menuitem"
                                               t-att-href="'/shop/change_pricelist/%s' % pl.id"
                                               t-attf-class="dropdown-item #{'active' if pricelist and pricelist.id == pl.id else ''}"
                                               t-out="pl.name"/>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <a href="#" class="k-inline-select" aria-label="Currency">
                                        <span t-out="pricelist and pricelist.name or website.currency_id.name"/>
                                        <i class="bi bi-chevron-down" aria-hidden="true"/>
                                    </a>
                                </t>
                                <t t-call="portal.language_selector"
                                   codes="True"
                                   _div_classes.f="d-inline-block"
                                   _btn_class.f="k-inline-select dropdown-toggle border-0 bg-transparent p-0 shadow-none"
                                   _dropdown_menu_class.f="dropdown-menu-end"/>
                            </div>
                        </div>

                        <div class="header-links-wrapper d-flex align-items-center">
                            <div class="header-links">
                                <ul class="mb-0 ps-0">
                                    <li>
                                        <a t-att-href="'tel:%s' % (res_company.phone or '+8801719304086')"
                                           class="k-phone-link"
                                           t-out="res_company.phone or '+8801719304086'"/>
                                    </li>
                                    <li t-if="website.has_ecommerce_access()" class="o_wsale_my_wish">
                                        <a href="/shop/wishlist" class="ico-wishlist">
                                            Wishlist (<span class="my_wish_quantity" t-out="wishcount"/>)
                                        </a>
                                    </li>
                                    <li class="user-account">
                                        <a t-att-href="is_logged_in and '/my/home' or '/web/login'">Account</a>
                                    </li>
                                    <li t-attf-class="o_wsale_my_cart #{'' if website.has_ecommerce_access() else 'd-none'}"
                                        id="topcartlink">
                                        <a href="/shop/cart"
                                           class="js_kingdom_cart_toggle"
                                           t-attf-aria-label="Shopping cart, #{website_sale_cart_quantity} items">
                                            <span class="cart-qty my_cart_quantity" t-out="website_sale_cart_quantity"/>
                                            <span class="cart-ammount"
                                                  t-out="website.currency_id.format(kingdom_cart_amount)"/>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

                </div>

            <div class="header-menu header-menu-static border-0 rounded-0 d-none d-lg-block w-100">
                <div class="mobile-menu-close" aria-hidden="true">×</div>
                <div class="container">
                    <div class="megamenu-wrapper align-items-center gap-1 gap-lg-2 w-100">
                        <div class="header-left-menu-dropdown">
                            <a class="header-left-menu-button" href="/shop">Categories</a>
                            <div class="mm-navbar navbar mobile-mm-navbar red-menu list-view show-image border-0 rounded-0 p-0">
                                <nav class="nav-navbar" aria-label="Browse categories">
                                    <ul class="nav-menu nav-center ps-0 mb-0">
                                        <t t-foreach="kingdom_root_categories" t-as="category">
                                            <t t-call="theme_kingdom.kingdom_header_category_item"/>
                                        </t>
                                    </ul>
                                </nav>
                            </div>
                        </div>

                        <div class="header-right-menu">
                            <div class="mm-navbar navbar mobile-mm-navbar grid-view no-view border-0 p-0">
                                <nav class="nav-navbar" aria-label="Top links">
                                    <ul class="nav-menu nav-center ps-0 mb-0 d-flex flex-wrap justify-content-lg-end">
                                        <t t-foreach="kingdom_top_menus" t-as="menu_item">
                                            <t t-call="theme_kingdom.kingdom_header_menu_item"/>
                                        </t>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            </div>

            <t t-call="theme_kingdom.kingdom_mobile_navigation_drawer"/>
        </xpath>

    </template>

    <template id="kingdom_mobile_category_item" name="Kingdom Mobile Category Item">
        <li class="nav-item border-bottom border-light-subtle pb-1 mb-1">
            <div class="d-flex align-items-center justify-content-between gap-2">
                <a class="nav-link px-0 text-dark flex-grow-1"
                   t-att-href="'/shop/category/%s' % category.id"
                   t-out="category.name"/>
                <button t-if="category.child_id"
                        type="button"
                        class="btn btn-sm btn-link text-dark px-2 k-mobile-cat-toggle"
                        t-att-data-k-target="'#kMobCat%s' % category.id"
                        aria-label="Toggle subcategories">
                    <i class="bi bi-chevron-down" aria-hidden="true"/>
                </button>
            </div>
            <ul t-if="category.child_id"
                t-attf-id="kMobCat#{category.id}"
                class="nav flex-column ps-3 k-mobile-cat-sub">
                <li t-foreach="category.child_id" t-as="child">
                    <a class="nav-link px-0 text-dark py-1 small"
                       t-att-href="'/shop/category/%s' % child.id"
                       t-out="child.name"/>
                </li>
            </ul>
        </li>
    </template>

    <template id="kingdom_mobile_navigation_drawer" name="Kingdom Mobile Navigation Drawer">
        <t t-set="website_sale_cart" t-value="request.cart"/>
        <t t-set="wishcount" t-value="len(request.env['product.wishlist'].current())"/>
        <t t-set="kingdom_root_categories" t-value="request.env['product.public.category'].kingdom_get_header_roots()"/>
        <t t-set="kingdom_top_menus" t-value="website.menu_id.child_id"/>
        <t t-set="is_logged_in" t-value="website.user_id != user_id"/>

        <div class="offcanvas offcanvas-start mobile-navigation-drawer"
             tabindex="-1"
             id="MobileNavigationDrawer"
             aria-labelledby="MobileNavigationDrawerLabel"
             data-bs-scroll="true"
             data-bs-backdrop="true">
            <div class="offcanvas-header border-bottom">
                <h5 class="offcanvas-title" id="MobileNavigationDrawerLabel">Menu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"/>
            </div>
            <div class="offcanvas-body">
                <a class="btn btn-outline-secondary w-100 mb-3 fw-semibold" href="/shop">
                    <i class="bi bi-grid-3x3-gap me-2" aria-hidden="true"/>
                    Categories
                </a>
                <ul class="nav flex-column gap-1 mb-3">
                    <t t-foreach="kingdom_root_categories" t-as="category">
                        <t t-call="theme_kingdom.kingdom_mobile_category_item"/>
                    </t>
                </ul>
                <ul class="nav flex-column gap-1 mb-4 border-top pt-3">
                    <t t-foreach="kingdom_top_menus" t-as="menu_item">
                        <li>
                            <a class="nav-link px-0 text-dark"
                               t-att-href="menu_item.url or '#'"
                               t-out="menu_item.name"/>
                        </li>
                        <t t-if="menu_item.child_id">
                            <li t-foreach="menu_item.child_id" t-as="submenu" class="ps-3">
                                <a class="nav-link px-0 text-dark py-1 small"
                                   t-att-href="submenu.url or '#'"
                                   t-out="submenu.name"/>
                            </li>
                        </t>
                    </t>
                </ul>
                <form method="get" action="/shop" role="search" class="mb-4">
                    <label class="form-label small text-muted" for="kSearchQueryMob">Search store</label>
                    <div class="input-group">
                        <input id="kSearchQueryMob"
                               type="search"
                               name="search"
                               class="form-control"
                               placeholder="Search store"
                               autocomplete="off"/>
                        <button type="submit" class="btn btn-dark" aria-label="Search">
                            <i class="bi bi-search"/>
                        </button>
                    </div>
                </form>
                <div class="border-top pt-3 small">
                    <p class="mb-2"><a href="/terms">Terms &amp; conditions</a></p>
                    <p class="mb-2"><a href="/contactus">Contact Us</a></p>
                    <p class="mb-2">
                        <a t-att-href="'tel:%s' % (res_company.phone or '+8801719304086')"
                           t-out="res_company.phone or '+8801719304086'"/>
                    </p>
                    <p class="mb-0">
                        <span t-if="website.has_ecommerce_access()" class="o_wsale_my_wish d-inline">
                            <a href="/shop/wishlist">
                                Wishlist (<span class="my_wish_quantity" t-out="wishcount"/>)
                            </a>
                        </span>
                        <span t-if="website.has_ecommerce_access()" class="text-muted mx-2">|</span>
                        <a t-att-href="is_logged_in and '/my/home' or '/web/login'">Account</a>
                    </p>
                </div>
            </div>
        </div>
    </template>

</odoo>
