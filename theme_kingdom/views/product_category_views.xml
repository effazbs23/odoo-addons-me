<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kingdom_product_category_list" model="ir.ui.view">
        <field name="name">product.public.category.list.kingdom</field>
        <field name="model">product.public.category</field>
        <field name="inherit_id" ref="website_sale.product_public_category_tree_view"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="show_in_homepage"
                       string="Show in Homepage"
                       widget="boolean_toggle"/>
            </field>
        </field>
    </record>

    <record id="kingdom_product_category_form" model="ir.ui.view">
        <field name="name">product.public.category.form.kingdom</field>
        <field name="model">product.public.category</field>
        <field name="inherit_id" ref="website_sale.product_public_category_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="show_in_homepage"/>
            </field>
        </field>
    </record>
</odoo>
