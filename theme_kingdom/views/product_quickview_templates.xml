<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add to Cart trigger (Kingdom icon + Odoo cart interaction) -->
    <template id="product_add_to_cart_button" name="Kingdom Add to Cart Button">
        <t t-set="action_variant_id"
           t-value="action_variant_id or product._get_first_possible_variant_id()"/>
        <t t-set="can_quick_add"
           t-value="product._is_add_to_cart_possible() and product._website_show_quick_add()"/>
        <button t-if="can_quick_add and action_variant_id"
                type="button"
                class="button-2 product-box-add-to-cart-button s_add_to_cart_btn kingdom-addtocart-btn"
                title="Add to cart"
                aria-label="Add to cart"
                data-action="add_to_cart"
                data-show-quantity="false"
                t-att-data-product-template-id="product.id"
                t-att-data-product-variant-id="action_variant_id if product.product_variant_count == 1 else None"
                t-att-data-product-type="product.type">
            <span class="visually-hidden o_translate_inline">Add to cart</span>
        </button>
    </template>

    <!-- Quick View trigger button -->
    <template id="product_quickview_button" name="Kingdom Quick View Button">
        <button type="button"
                class="button-2 quick-view-button kingdom-quickview-btn"
                title="Quick view"
                aria-label="Quick view"
                t-att-data-product-template-id="product.id">
            <span class="visually-hidden o_translate_inline">Quick view</span>
        </button>
    </template>

    <!-- Wishlist trigger (Kingdom icon + Odoo wishlist interaction) -->
    <template id="product_wishlist_button" name="Kingdom Wishlist Button">
        <t t-set="action_variant_id"
           t-value="action_variant_id or product._get_first_possible_variant_id()"/>
        <t t-set="in_wish"
           t-value="action_variant_id and request.env['product.product'].browse(action_variant_id).kingdom_is_in_wishlist()"/>
        <button t-if="action_variant_id"
                type="button"
                t-attf-class="button-2 add-to-wishlist-button o_add_wishlist kingdom-wishlist-btn #{in_wish and 'o_in_wishlist' or ''}"
                t-att-disabled="in_wish or None"
                t-att-title="in_wish and 'In your wishlist' or 'Add to wishlist'"
                t-att-aria-label="in_wish and 'In your wishlist' or 'Add to wishlist'"
                t-att-aria-pressed="in_wish and 'true' or 'false'"
                t-att-data-product-template-id="product.id"
                t-att-data-product-product-id="action_variant_id"
                data-action="o_wishlist">
            <span class="visually-hidden o_translate_inline">Add to wishlist</span>
        </button>
    </template>

    <!-- Compare trigger (Kingdom icon + Odoo comparison interaction) -->
    <template id="product_compare_button" name="Kingdom Compare Button">
        <t t-set="action_variant_id"
           t-value="action_variant_id or product._get_first_possible_variant_id()"/>
        <button t-if="action_variant_id"
                type="button"
                class="button-2 add-to-compare-list-button o_add_compare kingdom-compare-btn"
                title="Compare"
                aria-label="Compare"
                t-att-data-product-template-id="product.id"
                t-att-data-product-product-id="action_variant_id"
                data-action="o_comparelist">
            <span class="visually-hidden o_translate_inline">Compare</span>
        </button>
    </template>

    <!-- Shared icon toolbar for snippets / product cards -->
    <template id="product_card_action_buttons" name="Kingdom Product Card Actions">
        <t t-set="action_variant_id" t-value="product._get_first_possible_variant_id()"/>
        <t t-set="show_quickview" t-value="True if show_quickview is None else show_quickview"/>
        <div class="kingdom-product-actions" role="group" aria-label="Product actions">
            <t t-call="theme_kingdom.product_add_to_cart_button"/>
            <t t-call="theme_kingdom.product_compare_button"/>
            <t t-call="theme_kingdom.product_wishlist_button"/>
            <t t-if="show_quickview" t-call="theme_kingdom.product_quickview_button"/>
        </div>
    </template>

    <!-- Product ribbons: only render when the product has a ribbon assigned. -->
    <template id="product_card_ribbons" name="Kingdom Product Card Ribbons">
        <t t-set="ribbon"
           t-value="product.sudo().product_variant_id.variant_ribbon_id or product.sudo().website_ribbon_id"/>
        <t t-if="ribbon">
            <t t-set="is_carousel_ribbon" t-value="ribbon_style == 'carousel'"/>
            <t t-set="rkey" t-value="((ribbon.assign or '') + ' ' + (ribbon.name or '')).lower()"/>
            <t t-set="is_new" t-value="'new' in rkey"/>
            <div t-attf-class="kingdom-product-ribbons #{is_carousel_ribbon and 'product-carousel-badges' or 'featured-product-badges'}">
                <span t-if="is_carousel_ribbon"
                      t-attf-class="product-carousel-badge #{is_new and 'product-carousel-badge--new' or 'product-carousel-badge--top'}"
                      t-esc="ribbon.name"/>
                <span t-else=""
                      t-attf-class="#{is_new and 'badge-new' or 'badge-top'}"
                      t-esc="ribbon.name"/>
            </div>
        </t>
    </template>

    <!-- Modal shell mounted once on the website layout -->
    <template id="product_quickview_modal_shell" inherit_id="website.layout" name="Kingdom Quick View Modal">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <div id="kingdom_quickview_modal"
                 class="kingdom-quickview-modal"
                 aria-hidden="true"
                 hidden="hidden">
                <div class="kingdom-quickview-modal__backdrop" data-kingdom-quickview-close="1"/>
                <div class="kingdom-quickview-modal__dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="kingdom_quickview_title">
                    <button type="button"
                            class="kingdom-quickview-modal__close"
                            data-kingdom-quickview-close="1"
                            aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                    <div class="kingdom-quickview-modal__body">
                        <div class="kingdom-quickview-modal__loading o_translate_inline">Loading…</div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Dynamic modal body rendered by /shop/quickview -->
    <template id="product_quickview_content" name="Kingdom Quick View Content">
        <div class="kingdom-quickview js_sale"
             t-att-data-product-template-id="product.id"
             t-att-data-product-type="product.type"
             t-att-data-needs-full-page="'1' if needs_full_page else '0'">
            <form class="js_product js_main_product kingdom-quickview__form" t-att-action="product.website_url">
                <input type="hidden" class="product_template_id" name="product_template_id" t-att-value="product.id"/>
                <input type="hidden" class="product_id" name="product_id" t-att-value="product_variant.id"/>
                <input type="hidden" name="product_type" t-att-value="product.type"/>

                <div class="kingdom-quickview__grid">
                    <div class="kingdom-quickview__gallery">
                        <img class="kingdom-quickview__image"
                             t-att-src="'/web/image/product.product/%s/image_1024' % product_variant.id if product_variant else '/web/image/product.template/%s/image_1024' % product.id"
                             t-att-alt="product.name"
                             loading="lazy"/>
                    </div>

                    <div class="kingdom-quickview__details">
                        <h2 id="kingdom_quickview_title" class="kingdom-quickview__title" t-esc="product.name"/>

                        <div class="kingdom-quickview__price">
                            <t t-call="website_sale.product_price"/>
                        </div>

                        <div t-if="description_html" class="kingdom-quickview__description" t-out="description_html"/>
                        <p t-elif="description" class="kingdom-quickview__description" t-esc="description"/>

                        <t t-if="not needs_full_page and product.has_configurable_attributes">
                            <div class="kingdom-quickview__variants">
                                <t t-call="website_sale.variants">
                                    <t t-set="ul_class" t-value="'flex-column'"/>
                                    <t t-set="parent_combination" t-value="None"/>
                                </t>
                            </div>
                        </t>

                        <div t-if="needs_full_page" class="kingdom-quickview__fullpage-note alert alert-info mb-3">
                            <span class="o_translate_inline">
                                This product needs extra configuration. Open the full product page to continue.
                            </span>
                        </div>

                        <div class="kingdom-quickview__actions">
                            <div t-if="can_add_to_cart" class="kingdom-quickview__qty css_quantity input-group">
                                <button type="button"
                                        class="btn btn-link js_add_cart_json kingdom-quickview__qty-btn"
                                        data-kingdom-qty="-1"
                                        aria-label="Remove one">
                                    <i class="fa fa-minus"/>
                                </button>
                                <input type="text"
                                       class="form-control quantity text-center"
                                       name="add_qty"
                                       value="1"
                                       inputmode="numeric"/>
                                <button type="button"
                                        class="btn btn-link js_add_cart_json kingdom-quickview__qty-btn"
                                        data-kingdom-qty="1"
                                        aria-label="Add one">
                                    <i class="fa fa-plus"/>
                                </button>
                            </div>

                            <button t-if="can_add_to_cart"
                                    type="button"
                                    class="btn btn-primary kingdom-quickview__add-to-cart a-submit">
                                <i class="fa fa-shopping-cart me-1"/>
                                <span class="o_translate_inline">Add to Cart</span>
                            </button>

                            <a class="btn btn-outline-secondary kingdom-quickview__details-link"
                               t-att-href="product.website_url">
                                <span class="o_translate_inline">View full details</span>
                            </a>
                        </div>

                        <div class="kingdom-quickview__unavailable css_not_available_msg d-none alert alert-warning mt-3 mb-0">
                            <span class="o_translate_inline">This combination does not exist.</span>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </template>

    <!-- Shop list panel: keep variant swatches with price/actions -->
    <template id="kingdom_products_item_list_panel"
              inherit_id="website_sale.products_item"
              name="Kingdom Shop List Panel"
              priority="30">
        <!-- Drop attributes from the text column -->
        <xpath expr="//div[hasclass('o_wsale_product_info_attributes_wrapper')]/t[@t-call='website_sale.product_variant_preview']"
               position="replace"/>
        <!-- Re-inject at top of price/actions cluster -->
        <xpath expr="//div[hasclass('o_wsale_product_sub')]" position="inside">
            <t t-if="product_ptavs_data" t-call="website_sale.product_variant_preview"/>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_product_sub')]" position="attributes">
            <attribute name="class" add="k-shop-list-panel" separator=" "/>
        </xpath>
    </template>

    <!-- Variant swatches: no details navigation; select on /shop instead -->
    <template id="kingdom_product_variant_preview_data"
              inherit_id="website_sale.product_variant_preview"
              name="Kingdom Variant Preview Data">
        <xpath expr="//a[hasclass('o_product_variant_preview')]" position="attributes">
            <attribute name="t-att-href">'#'</attribute>
            <attribute name="role">button</attribute>
            <attribute name="t-att-data-variant-url">previewed_ptav['variant_url']</attribute>
            <attribute name="t-att-data-product-id">min(ptav.ptav_product_variant_ids, key=lambda p: p.id).id</attribute>
            <attribute name="t-att-data-ptav-id">ptav.id</attribute>
        </xpath>
    </template>

    <!-- Shop product tile: Quick View + list CTA (qty / Buy Now) -->
    <template id="shop_product_buttons_quickview" inherit_id="website_sale.shop_product_buttons" name="Kingdom Shop Quick View">
        <xpath expr="//div[hasclass('o_wsale_product_action_row')]" position="before">
            <t t-if="product._website_show_quick_add()">
                <div class="k-shop-list-cta">
                    <div class="k-shop-qty css_quantity input-group" contenteditable="false">
                        <input type="text"
                               class="form-control quantity text-center"
                               name="add_qty"
                               value="1"
                               data-min="1"
                               aria-label="Quantity"/>
                        <div class="k-shop-qty__btns">
                            <a href="#"
                               class="css_quantity_plus js_add_cart_json"
                               aria-label="Add one"
                               title="Add one">
                                <i class="oi oi-plus" aria-hidden="true"/>
                            </a>
                            <a href="#"
                               class="css_quantity_minus js_add_cart_json"
                               aria-label="Remove one"
                               title="Remove one"
                               name="remove_one">
                                <i class="oi oi-minus" aria-hidden="true"/>
                            </a>
                        </div>
                    </div>
                    <button type="button"
                            class="k-shop-buy-now a-submit o_we_buy_now"
                            aria-label="Buy Now"
                            title="Buy Now">
                        Buy Now
                    </button>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_product_action_row')]" position="inside">
            <t t-call="theme_kingdom.product_quickview_button"/>
        </xpath>
    </template>

</odoo>
