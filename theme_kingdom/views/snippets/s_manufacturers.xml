                                        </a>
                                        <div class="manufacturer-name"><a href="#">Scanfrost</a></div>
                                    </div>
                                </div>
                                <div class="swiper-slide col-4 col-sm-3 col-lg-2 col-xl-1_5">
                                    <div class="manufacturer-item">
                                        <a class="manufacturer-picture" href="#" title="Walton">
                                            <img src="/theme_kingdom/static/src/images/0000746_walton_400.webp" alt="Walton" loading="lazy"/>
                                        </a>
                                        <div class="manufacturer-name"><a href="#">Walton</a></div>
                                    </div>
                                    <div class="manufacturer-item">
