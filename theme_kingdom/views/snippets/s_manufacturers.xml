<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="s_manufacturers" name="Kingdom Manufacturers">
        <t t-set="manufacturer_slides"
           t-value="'kingdom.manufacturer' in request.env and request.env['kingdom.manufacturer'].sudo().get_website_manufacturer_slides(per_slide=2) or []"/>
        <t t-set="has_manufacturers" t-value="bool(manufacturer_slides)"/>

        <section class="s_manufacturers home-manufacturers-section carousel-grid"
                 data-snippet="theme_kingdom.s_manufacturers"
                 data-kingdom-live-snippet="s_manufacturers"
                 data-name="Manufacturers"
                 aria-labelledby="ManufacturersHeading">
            <div class="k-container container">
                <div class="home-manufacturers-head title">
                    <h2 id="ManufacturersHeading" class="o_translate_inline"><strong>Manufacturers</strong></h2>
                </div>

                <div class="carousel-container swiperCarousel carousel-manufacturer">
                    <div class="swiper-button-prev manufacturer-carousel-arrow" aria-label="Previous manufacturers"/>
                    <div class="swiper-button-next manufacturer-carousel-arrow" aria-label="Next manufacturers"/>
                    <div class="swiper manufacturer manufacturer-swiper">
                        <div class="swiper-wrapper">
                            <!-- Configured brands from Website → Manufacturers -->
                            <t t-if="has_manufacturers">
                                <t t-foreach="manufacturer_slides" t-as="slide_brands">
                                    <div class="swiper-slide col-4 col-sm-3 col-lg-2 col-xl-1_5">
                                        <t t-foreach="slide_brands" t-as="brand">
                                            <t t-set="brand_href"
                                               t-value="brand.get_shop_url()"/>
                                            <div class="manufacturer-item">
                                                <a class="manufacturer-picture"
                                                   t-att-href="brand_href"
                                                   t-att-title="brand.name">
                                                    <img t-if="brand.image"
                                                         t-att-src="'/web/image/kingdom.manufacturer/%s/image' % brand.id"
                                                         t-att-alt="brand.name"
                                                         loading="lazy"/>
                                                    <span t-else=""
                                                          class="manufacturer-picture-fallback"
                                                          t-esc="brand.name"/>
                                                </a>
                                                <div class="manufacturer-name">
                                                    <a t-att-href="brand_href" t-esc="brand.name"/>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </t>
                            <!-- Fallback demo brands when none are configured -->
                            <t t-else="">
                                <div class="swiper-slide col-4 col-sm-3 col-lg-2 col-xl-1_5">
                                    <div class="manufacturer-item">
                                        <a class="manufacturer-picture" href="#" title="Acer">
                                            <img src="/theme_kingdom/static/src/images/0000151_acer_400.webp" alt="Acer" loading="lazy"/>
                                        </a>
                                        <div class="manufacturer-name"><a href="#">Acer</a></div>
                                    </div>
                                    <div class="manufacturer-item">
                                        <a class="manufacturer-picture" href="#" title="Cisco">
                                            <img src="/theme_kingdom/static/src/images/0000152_cisco_400.webp" alt="Cisco" loading="lazy"/>
                                        </a>
                                        <div class="manufacturer-name"><a href="#">Cisco</a></div>
                                    </div>
                                </div>
                                <div class="swiper-slide col-4 col-sm-3 col-lg-2 col-xl-1_5">
                                    <div class="manufacturer-item">
                                        <a class="manufacturer-picture" href="#" title="Iittala">
                                            <img src="/theme_kingdom/static/src/images/0000153_iittala_400.webp" alt="Iittala" loading="lazy"/>
                                        </a>
                                        <div class="manufacturer-name"><a href="#">Iittala</a></div>
                                    </div>
                                    <div class="manufacturer-item">
                                        <a class="manufacturer-picture" href="#" title="Panasonic">
                                            <img src="/theme_kingdom/static/src/images/0000154_panasonic_400.webp" alt="Panasonic" loading="lazy"/>
                                        </a>
                                        <div class="manufacturer-name"><a href="#">Panasonic</a></div>
                                    </div>
                                </div>
                                <div class="swiper-slide col-4 col-sm-3 col-lg-2 col-xl-1_5">
                                    <div class="manufacturer-item">
                                        <a class="manufacturer-picture" href="#" title="Philips">
                                            <img src="/theme_kingdom/static/src/images/0000155_philips_400.webp" alt="Philips" loading="lazy"/>
                                        </a>
                                        <div class="manufacturer-name"><a href="#">Philips</a></div>
                                    </div>
                                    <div class="manufacturer-item">
                                        <a class="manufacturer-picture" href="#" title="Sony">
                                            <img src="/theme_kingdom/static/src/images/0000157_sony_400.webp" alt="Sony" loading="lazy"/>
                                        </a>
                                        <div class="manufacturer-name"><a href="#">Sony</a></div>
