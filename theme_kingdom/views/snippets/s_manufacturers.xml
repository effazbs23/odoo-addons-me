                                            <img src="/theme_kingdom/static/src/images/0000747_dometic-coolmatic_400.webp" alt="Dometic" loading="lazy"/>
                                        </a>
                                        <div class="manufacturer-name"><a href="#">Dometic</a></div>
                                    </div>
                                </div>
                                <div class="swiper-slide col-4 col-sm-3 col-lg-2 col-xl-1_5">
                                    <div class="manufacturer-item">
                                        <a class="manufacturer-picture" href="#" title="LG">
                                            <img src="/theme_kingdom/static/src/images/0000121_lg_400.webp" alt="LG" loading="lazy"/>
                                        </a>
                                        <div class="manufacturer-name"><a href="#">LG</a></div>
                                    </div>
                                    <div class="manufacturer-item">
                                        <a class="manufacturer-picture" href="#" title="Corkcicle">
                                            <img src="/theme_kingdom/static/src/images/0000123_corkcicle_400.webp" alt="Corkcicle" loading="lazy"/>
                                        </a>
                                        <div class="manufacturer-name"><a href="#">Corkcicle</a></div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
