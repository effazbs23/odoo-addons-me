<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Horizontal card: thumbnail left, title / stars / price right (nopCommerce product tab). -->
    <template id="product_carousel_product_cell" name="Product carousel product cell">
        <t t-set="rating_rounded"
           t-value="min(5, max(0, int(round(product.sudo().rating_avg or 0))))"/>
        <article class="product-carousel-cell">
            <div class="product-carousel-cell__media">
                <a t-att-href="product.website_url" class="product-carousel-cell__img-link">
                    <img t-att-src="'/web/image/product.template/%s/image_128' % product.id"
                         t-att-alt="product.name"
                         width="96"
                         height="96"
                         loading="lazy"/>
                </a>
                <t t-if="product.website_ribbon_id">
                    <t t-set="ribbon_name" t-value="(product.website_ribbon_id.name or '').lower()"/>
                    <span t-attf-class="product-carousel-badge #{('product-carousel-badge--new' if 'new' in ribbon_name else 'product-carousel-badge--top')}"
                          t-esc="product.website_ribbon_id.name"/>
                </t>
            </div>
            <div class="product-carousel-cell__text">
                <h3 class="product-carousel-cell__title">
                    <a t-att-href="product.website_url" t-esc="product.name"/>
                </h3>
                <div class="product-carousel-cell__stars" t-att-aria-label="'%s out of 5 stars' % rating_rounded">
                    <t t-foreach="range(1, 6)" t-as="star_i">
                        <i t-attf-class="bi #{('bi-star-fill' if star_i &lt;= rating_rounded else 'bi-star')}"
                           aria-hidden="true"/>
                    </t>
                </div>
                <div class="product-carousel-cell__prices">
                    <t t-call="theme_kingdom.product_card_price">
                        <t t-set="pricelist" t-value="current_pricelist"/>
                        <t t-set="display_currency" t-value="display_currency"/>
                    </t>
                </div>
            </div>
        </article>
    </template>

    <!-- Product carousel panel — products_per_slide from Product Carousel Tabs config -->
    <template id="product_carousel_panel" name="Product carousel panel">
        <t t-set="per_slide" t-value="per_slide or 10"/>
        <div t-attf-class="product-carousel-panels #{panel_hidden and 'd-none' or ''}"
             t-att-id="panel_id"
             role="tabpanel"
             t-att-aria-labelledby="tab_id"
             t-att-data-product-carousel-panel="panel_key"
             t-att-hidden="panel_hidden and 'hidden' or None">
            <div t-attf-class="swiper product-carousel-swiper product-carousel-swiper--#{panel_key}">
                <div class="swiper-wrapper">
                    <t t-if="products">
                        <t t-foreach="range(0, len(products), per_slide)" t-as="i">
                            <div class="swiper-slide">
                                <div class="product-carousel-grid">
                                    <t t-foreach="products[i:i + per_slide]" t-as="product">
                                        <t t-call="theme_kingdom.product_carousel_product_cell"/>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </t>
                    <t t-else="">
                        <div class="swiper-slide">
                            <div class="product-carousel-grid"/>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </template>

    <template id="s_product_carousel" name="Kingdom Product Carousel">
        <section class="s_product_carousel oe_website_sale js_sale product-carousel-section"
                 data-snippet="theme_kingdom.s_product_carousel"
                 data-kingdom-live-snippet="s_product_carousel"
                 data-name="Product Carousel"
                 aria-labelledby="ProductCarouselHeading">
            <div class="k-container">
                <t t-set="has_tab_model" t-value="'kingdom.product.tab' in request.env"/>
                <t t-set="carousel_tabs"
                   t-value="request.env['kingdom.product.tab'].sudo().get_product_carousel_tabs() if has_tab_model else request.env['kingdom.product.tab']"/>
                <t t-set="banner_tab"
                   t-value="request.env['kingdom.product.tab'].sudo().get_product_carousel_banner_tab() if has_tab_model else False"/>
                <t t-set="per_slide"
                   t-value="request.env['kingdom.product.tab'].sudo().get_product_carousel_per_slide() if has_tab_model else 10"/>
                <t t-set="website" t-value="website or env['website'].get_current_website()"/>
                <t t-set="_pl_sid" t-value="request.session.get('website_sale_current_pl')"/>
                <t t-set="_pl_session"
                   t-value="_pl_sid and request.env['product.pricelist'].sudo().browse(int(_pl_sid))"/>
                <t t-set="current_pricelist"
                   t-value="(_pl_session and _pl_session.exists() and _pl_session) or (website.get_pricelist_available(show_visible=False)[:1] if website else request.env['product.pricelist'])"/>
                <t t-set="display_currency"
                   t-value="(current_pricelist and current_pricelist.currency_id) or (website and website.currency_id) or request.env.company.currency_id"/>
                <t t-set="pc_uid" t-value="'pc%s' % (banner_tab.id if banner_tab else (carousel_tabs[:1].id if carousel_tabs else 0))"/>
                <t t-set="heading_label"
                   t-value="(banner_tab and banner_tab.get_display_title()) or (carousel_tabs[:1].name if carousel_tabs else 'Product Carousel')"/>
                <h2 t-att-id="'ProductCarouselHeading'" class="visually-hidden" t-esc="heading_label"/>

                <t t-if="carousel_tabs">
                    <div class="product-carousel-shell">
                        <a t-att-href="banner_tab.get_feature_href() if banner_tab else '/shop'"
                           class="product-carousel-feature">
                            <span class="product-carousel-feature__bg"
                                  t-att-style="'background-image: url(%s);' % (banner_tab.get_feature_bg_url() if banner_tab else '/theme_kingdom/static/src/images/categories/cat-3.jpg')"/>
                            <span class="product-carousel-feature__caption"
                                  t-esc="banner_tab.get_feature_ribbon() if banner_tab else 'Shop now'"/>
                        </a>

                        <div class="product-carousel-main">
                            <div class="product-carousel-toolbar">
                                <div class="product-carousel-tabs"
                                     role="tablist"
                                     aria-label="Product groups">
                                    <t t-foreach="carousel_tabs" t-as="carousel_tab">
                                        <t t-set="panel_key" t-value="str(carousel_tab.id)"/>
                                        <t t-set="is_first_tab" t-value="carousel_tab_index == 0"/>
                                        <button type="button"
                                                t-attf-class="product-carousel-tab #{is_first_tab and 'is-active' or ''}"
                                                role="tab"
                                                t-att-id="'%sTab%s' % (pc_uid, panel_key)"
                                                t-att-aria-selected="'true' if is_first_tab else 'false'"
                                                t-att-aria-controls="'%sPanel%s' % (pc_uid, panel_key)"
                                                t-att-data-product-carousel-tab="panel_key"
                                                t-att-tabindex="0 if is_first_tab else -1">
                                            <t t-esc="carousel_tab.name"/>
                                        </button>
                                    </t>
                                </div>
                                <div class="product-carousel-toolbar-nav" aria-live="polite">
                                    <t t-foreach="carousel_tabs" t-as="carousel_tab">
                                        <t t-set="panel_key" t-value="str(carousel_tab.id)"/>
                                        <t t-set="is_first_tab" t-value="carousel_tab_index == 0"/>
                                        <div t-attf-class="product-carousel-nav-group #{(not is_first_tab) and 'd-none' or ''}"
                                             t-att-id="'%sNav%s' % (pc_uid, panel_key)"
                                             t-att-data-nav-for="panel_key"
                                             t-att-hidden="(not is_first_tab) and 'hidden' or None">
                                            <div class="swiper-button-prev product-carousel-arrow"
                                                 aria-label="Previous products"/>
                                            <div class="swiper-button-next product-carousel-arrow"
                                                 aria-label="Next products"/>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <t t-foreach="carousel_tabs" t-as="carousel_tab">
                                <t t-set="panel_key" t-value="str(carousel_tab.id)"/>
                                <t t-set="is_first_tab" t-value="carousel_tab_index == 0"/>
                                <t t-set="tab_products" t-value="carousel_tab.get_products()"/>
                                <t t-call="theme_kingdom.product_carousel_panel">
                                    <t t-set="products" t-value="tab_products"/>
                                    <t t-set="panel_key" t-value="panel_key"/>
                                    <t t-set="panel_id" t-value="'%sPanel%s' % (pc_uid, panel_key)"/>
                                    <t t-set="tab_id" t-value="'%sTab%s' % (pc_uid, panel_key)"/>
                                    <t t-set="panel_hidden" t-value="not is_first_tab"/>
                                    <t t-set="per_slide" t-value="per_slide"/>
                                </t>
                            </t>
                        </div>
                    </div>
                </t>
                <t t-elif="editable">
                    <div class="css_non_editable_mode_hidden">
                        <div class="alert alert-info mb-0 o_not_editable">
                            No Product Carousel tabs yet. Use the snippet <em>Configure</em> button,
                            create tabs (any type), enable <strong>Product carousel snippet</strong>,
                            set products / Feature Banner, and order with Sequence.
                        </div>
                    </div>
                </t>
            </div>
        </section>
    </template>
</odoo>
