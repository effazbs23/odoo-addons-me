<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_product_carousel" name="Kingdom Product Carousel">
        <section class="product-carousel-section" aria-labelledby="ProductCarouselHeading">
            <h2 id="ProductCarouselHeading" class="visually-hidden">Featured products</h2>
            <div class="k-container">
                <t t-set="new_tab"
                   t-value="request.env['kingdom.product.tab'].sudo().search([('active', '=', True), ('tab_type', '=', 'new_arrival')], order='sequence asc, id asc', limit=1)"/>
                <t t-set="best_tab"
                   t-value="request.env['kingdom.product.tab'].sudo().search([('active', '=', True), ('tab_type', '=', 'best_seller')], order='sequence asc, id asc', limit=1)"/>
                <t t-set="feature_tab" t-value="new_tab or best_tab"/>
                <t t-set="current_pricelist"
                   t-value="(request.session.get('website_sale_current_pl') and request.env['product.pricelist'].sudo().browse(int(request.session.get('website_sale_current_pl')))) or (website and website._get_and_cache_current_pricelist())"/>
                <t t-set="display_currency"
                   t-value="(current_pricelist and current_pricelist.currency_id) or request.env.company.currency_id"/>
                <t t-set="new_arrival_label" t-value="new_tab.name if new_tab else 'New Arrivals'"/>
                <t t-set="best_seller_label" t-value="best_tab.name if best_tab else 'Best Sellers'"/>

                <t t-if="feature_tab">
                    <div class="product-carousel-shell">
                        <a t-att-href="feature_tab.get_feature_href()"
                           class="product-carousel-feature">
                            <span class="product-carousel-feature__bg"
                                  t-att-style="'background-image: url(%s);' % feature_tab.get_feature_bg_url()"/>
                            <span class="product-carousel-feature__caption" t-esc="feature_tab.get_feature_ribbon()"/>
                        </a>

                        <div class="product-carousel-main">
                            <div class="product-carousel-toolbar">
                                <div class="product-carousel-tabs" role="tablist">
                                    <t t-if="new_tab">
                                        <button type="button"
                                                t-attf-class="product-carousel-tab #{best_tab and 'is-active' or 'is-active'}"
                                                role="tab"
                                                aria-selected="true"
                                                data-product-carousel-tab="new">
                                            <t t-esc="new_arrival_label"/>
                                        </button>
                                    </t>
                                    <t t-if="best_tab">
                                        <button type="button"
                                                t-attf-class="product-carousel-tab #{new_tab and '' or 'is-active'}"
                                                role="tab"
                                                t-att-aria-selected="'false' if new_tab else 'true'"
                                                t-att-tabindex="'-1' if new_tab else None"
                                                data-product-carousel-tab="best">
                                            <t t-esc="best_seller_label"/>
                                        </button>
                                    </t>
                                </div>
                                <div class="product-carousel-toolbar-nav">
                                    <t t-if="new_tab">
                                        <div class="product-carousel-nav-group" data-nav-for="new">
                                            <div class="swiper-button-prev product-carousel-arrow"/>
                                            <div class="swiper-button-next product-carousel-arrow"/>
                                        </div>
                                    </t>
                                    <t t-if="best_tab">
                                        <div t-attf-class="product-carousel-nav-group #{new_tab and 'd-none' or ''}"
                                             data-nav-for="best"
                                             t-att-hidden="new_tab and 'hidden' or None">
                                            <div class="swiper-button-prev product-carousel-arrow"/>
                                            <div class="swiper-button-next product-carousel-arrow"/>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <t t-if="new_tab">
                                <t t-set="new_products" t-value="new_tab.get_products()"/>
                                <div class="product-carousel-panels"
                                     data-product-carousel-panel="new">
                                    <div class="swiper product-carousel-swiper product-carousel-swiper--new">
                                        <div class="swiper-wrapper">
                                            <t t-foreach="range(0, len(new_products), 8)" t-as="i">
                                                <div class="swiper-slide">
                                                    <div class="product-carousel-grid">
                                                        <t t-foreach="new_products[i:i+8]" t-as="product">
                                                            <t t-call="theme_kingdom.category_dual_product_cell"/>
                                                        </t>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <t t-if="best_tab">
                                <t t-set="best_products" t-value="best_tab.get_products()"/>
                                <div t-attf-class="product-carousel-panels #{new_tab and 'd-none' or ''}"
                                     data-product-carousel-panel="best"
                                     t-att-hidden="new_tab and 'hidden' or None">
                                    <div class="swiper product-carousel-swiper product-carousel-swiper--best">
                                        <div class="swiper-wrapper">
                                            <t t-foreach="range(0, len(best_products), 8)" t-as="i">
                                                <div class="swiper-slide">
                                                    <div class="product-carousel-grid">
                                                        <t t-foreach="best_products[i:i+8]" t-as="product">
                                                            <t t-call="theme_kingdom.category_dual_product_cell"/>
                                                        </t>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </section>
    </template>
</odoo>
