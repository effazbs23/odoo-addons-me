<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="theme_natural_foods_login_card_class" inherit_id="web.login" name="Natural Foods Login Card Class">
        <xpath expr="//div[@id='oe_structure_login_top']" position="before">
            <t t-set="login_card_classes" t-valuef="nf-auth-card"/>
        </xpath>
    </template>

    <template id="theme_natural_foods_signup_form" inherit_id="auth_signup.signup" name="Natural Foods Signup Form">
        <xpath expr="//div[@id='oe_structure_signup_top']" position="before">
            <t t-set="login_card_classes" t-valuef="nf-auth-card nf-signup-card"/>
        </xpath>

        <xpath expr="//form[hasclass('oe_signup_form')]" position="replace">
            <form class="oe_signup_form nf-signup-form" role="form" method="post" t-if="not message" data-captcha="signup">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <div class="nf-signup-logo text-center mb-3">
                    <img t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}" alt="Logo"/>
                </div>

                <section class="nf-signup-block mb-3">
                    <div class="nf-signup-block-head">Your Personal Details</div>
                    <div class="nf-signup-block-body">
                        <div class="nf-signup-inline-group mb-3">
                            <span class="nf-inline-label">Gender:</span>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="nf_gender" id="nf_gender_male" checked="checked"/>
                                <label class="form-check-label" for="nf_gender_male">Male</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="nf_gender" id="nf_gender_female"/>
                                <label class="form-check-label" for="nf_gender_female">Female</label>
                            </div>
                        </div>
                        <div class="mb-3 field-name">
                            <label for="name" class="form-label">First Name</label>
                            <input type="text" name="name" t-att-value="name" id="name" class="form-control" placeholder="Type.." autofocus="autofocus" required="required"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="nf_birth_dd">Date of Birth</label>
                            <div class="row g-2">
                                <div class="col-4">
                                    <select id="nf_birth_dd" class="form-select">
                                        <option>DD</option>
                                    </select>
                                </div>
                                <div class="col-4">
                                    <select class="form-select">
                                        <option>MM</option>
                                    </select>
                                </div>
                                <div class="col-4">
                                    <select class="form-select">
                                        <option>YY</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3 field-login">
                            <label for="login" class="form-label">Email</label>
                            <input type="text" name="login" t-att-value="login" id="login" class="form-control" t-att-autofocus="'autofocus' if login else None" autocapitalize="off" required="required" placeholder="name@example.com"/>
                        </div>
                    </div>
                </section>

                <section class="nf-signup-block mb-3">
                    <div class="nf-signup-block-head">Company Details</div>
                    <div class="nf-signup-block-body">
                        <label class="form-label" for="nf_company_name">Company Name</label>
                        <input type="text" id="nf_company_name" class="form-control" placeholder="Type.."/>
                    </div>
                </section>

                <section class="nf-signup-block mb-3">
                    <div class="nf-signup-block-head">Options</div>
                    <div class="nf-signup-block-body">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="nf_newsletter"/>
                            <label class="form-check-label" for="nf_newsletter">Newsletter</label>
                        </div>
                    </div>
                </section>

                <section class="nf-signup-block mb-2">
                    <div class="nf-signup-block-head">Your Password</div>
                    <div class="nf-signup-block-body">
                        <t t-call="auth_signup.fields"/>
                    </div>
                </section>

                <p class="alert alert-danger" t-if="error" role="alert">
                    <t t-esc="error"/>
                </p>

                <input type="hidden" name="redirect" t-att-value="redirect"/>
                <input type="hidden" name="token" t-att-value="token"/>

                <div class="text-center oe_login_buttons d-grid pt-2">
                    <button type="submit" class="btn btn-primary">Register</button>
                    <a t-attf-href="/web/login?{{ keep_query() }}" class="btn btn-link btn-sm mt-2" role="button">Already have an account?</a>
                    <t t-call="web.login_oauth"/>
                </div>
            </form>
        </xpath>
    </template>
</odoo>
