<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_best_seller_list" model="ir.ui.view">
        <field name="name">best.seller.list</field>
        <field name="model">best.seller</field>
        <field name="arch" type="xml">
            <list string="Best Seller">
                <field name="name"/>
                <field name="product_tmpl_ids"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_best_seller_form" model="ir.ui.view">
        <field name="name">best.seller.form</field>
        <field name="model">best.seller</field>
        <field name="arch" type="xml">
            <form string="Best Seller">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>

                    <group string="Products">
                        <field name="product_tmpl_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_best_seller" model="ir.actions.act_window">
        <field name="name">Best Seller</field>
        <field name="res_model">best.seller</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_best_seller"
        name="Best Seller"
        parent="website.menu_website_global_configuration"
        action="action_best_seller"
        sequence="20"/>

</odoo>