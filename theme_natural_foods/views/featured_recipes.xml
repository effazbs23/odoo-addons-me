<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_featured_recipes_list" model="ir.ui.view">
        <field name="name">featured.recipes.list</field>
        <field name="model">featured.recipes</field>
        <field name="arch" type="xml">
            <list string="Featured Recipes">
                <field name="name"/>
                <field name="subtitle"/>
                <field name="duration"/>
                <field name="category"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_featured_recipes_form" model="ir.ui.view">
        <field name="name">featured.recipes.form</field>
        <field name="model">featured.recipes</field>
        <field name="arch" type="xml">
            <form string="Featured Recipe">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="subtitle"/>
                        <field name="image"/>
                        <field name="duration"/>
                        <field name="category"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_featured_recipes" model="ir.actions.act_window">
        <field name="name">Featured Recipes</field>
        <field name="res_model">featured.recipes</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_featured_recipes"
        name="Featured Recipes"
        parent="website.menu_website_global_configuration"
        action="action_featured_recipes"
        sequence="25"/>

</odoo>