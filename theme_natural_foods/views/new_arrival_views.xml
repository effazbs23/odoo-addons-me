<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- List View -->
    <record id="view_new_arrival_list" model="ir.ui.view">
        <field name="name">new.arrival.list</field>
        <field name="model">new.arrival</field>
        <field name="arch" type="xml">
            <list string="New Arrival">
                <field name="name"/>
                <field name="product_tmpl_ids"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_new_arrival_form" model="ir.ui.view">
        <field name="name">new.arrival.form</field>
        <field name="model">new.arrival</field>
        <field name="arch" type="xml">
            <form string="New Arrival">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>

                    <group string="Products">
                        <field name="product_tmpl_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_new_arrival" model="ir.actions.act_window">
        <field name="name">New Arrival</field>
        <field name="res_model">new.arrival</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem
            id="menu_new_arrival_root"
            name="New Arrival"
            parent="website.menu_website_global_configuration"
            action="action_new_arrival"
            sequence="10"/>

</odoo>