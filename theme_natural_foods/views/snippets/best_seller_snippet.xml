<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="best_seller_snippet" name="Best Sale Snippet">
        <section class="product-carousel pt-5 bg-white oe_website_sale">
            <div class="container">
                <!-- Header -->
                <div class="row align-items-center mb-2">
                    <div class="col">
                        <h2 class="h2 fw-bold text-dark">Best Sale</h2>
                    </div>
                    <div class="col-auto">
                        <div class="carousel-navigation products-navigation d-flex gap-2">
                            <button class="carousel-prev products-prev btn btn-outline-organic rounded-circle p-2" type="button" aria-label="Previous products" id="prev-best">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <button class="carousel-next products-next btn btn-outline-organic rounded-circle p-2" type="button" aria-label="Next products" id="next-best">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Swiper Container -->
                <div class="swiper carousel-swiper products-swiper" id="swiper-best">
                    <div class="swiper-wrapper" data-nf-dynamic-container="best_seller">
                        <t t-call="theme_natural_foods.best_seller_items"/>
                    </div>
                </div>

            </div>
        </section>
    </template>

    <!-- Dynamic body: re-rendered server-side on every page load (see nf-dynamic-snippets.js) -->
    <template id="best_seller_items" name="Best Sale Items">
        <t t-set="current_pricelist" t-value="(request.session.get('website_sale_current_pl') and request.env['product.pricelist'].sudo().browse(int(request.session.get('website_sale_current_pl')))) or (website and website._get_and_cache_current_pricelist())"/>
        <t t-set="display_currency"
           t-value="(current_pricelist and current_pricelist.exists() and current_pricelist.currency_id) or request.env.company.currency_id"/>
        <t t-set="best" t-value="request.env['best.seller'].sudo().search([], limit=1)"/>

        <t t-foreach="best.product_tmpl_ids" t-as="product">
            <t t-set="contextual_price"
               t-value="(current_pricelist and product.with_context(pricelist=current_pricelist.id)._get_contextual_price()) or product._get_contextual_price()"/>
            <div class="swiper-slide col-6 col-md-4 col-lg-2-4">
                <div class="product-card shadow-hover border-0">

                    <div class="product-card-image position-relative">
                        <img t-att-src="'/web/image/product.template/%s/image_512' % product.id"/>
                        <div class="product-badge bg-warning bg-gradient text-white fw-bold">Best Sale</div>

                        <!-- Action Buttons -->
                        <div class="product-actions position-absolute top-0 end-0 m-2 d-flex flex-column gap-1 opacity-0">
                            <button class="btn btn-light btn-sm rounded-circle shadow-sm" t-att-onclick="'event.stopPropagation(); addToWishlist(%s);' % product.id" title="Add to Wishlist">
                                <i class="bi bi-heart"></i>
                            </button>
                            <button class="btn btn-light btn-sm rounded-circle shadow-sm"
                                    t-attf-onclick="event.preventDefault(); event.stopPropagation(); quickView(#{product.id});"
                                    t-att-data-quick-view-product-id="product.id"
                                    title="Quick View">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="p-3">
                        <h6 class="fw-semibold text-dark mb-2">
                            <t t-esc="product.name"/>
                        </h6>
                        <p class="text-muted small mb-2">
                            <t t-esc="product.categ_id.name if product.categ_id else ''"/>
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="h6 text-danger fw-bold">
                                    <t t-out="contextual_price"
                                       t-options="{'widget': 'monetary', 'display_currency': display_currency}"/>
                                </span>
                            </div>
                            <button type="button"
                               class="btn btn-sm btn-organic rounded-pill s_add_to_cart_btn"
                               t-att-data-product-template-id="product.id"
                               t-att-data-product-variant-id="product._get_first_possible_variant_id()"
                               t-att-data-product-type="product.type"
                               data-action="add_to_cart"
                               data-show-quantity="False">
                                <i class="bi bi-cart3"></i> Add
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </t>

        <!-- Empty State -->
        <t t-if="not best.product_tmpl_ids">
            <div class="text-center w-100 py-5">
                <i class="bi bi-basket text-muted" style="font-size: 3rem;"/>
                <p class="text-muted mt-3">No products at the moment. Check back soon!</p>
            </div>
        </t>
    </template>

</odoo>
