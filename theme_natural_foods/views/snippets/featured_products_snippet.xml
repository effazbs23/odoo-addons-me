<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="featured_products_snippet" name="Featured Products">
        <section class="featured-products py-5 oe_website_sale">
            <div class="container">
                <t t-set="current_pricelist" t-value="(request.session.get('website_sale_current_pl') and request.env['product.pricelist'].sudo().browse(int(request.session.get('website_sale_current_pl')))) or (website and website._get_and_cache_current_pricelist())"/>
                <t t-set="display_currency"
                   t-value="(current_pricelist and current_pricelist.exists() and current_pricelist.currency_id) or request.env.company.currency_id"/>

                <div class="carousel-wrapper products-carousel-wrapper position-relative">

                    <!-- Section Title -->
                    <div class="row align-items-center mb-2">
                        <div class="col">
                            <h2 class="h2 fw-bold text-white">Featured Products</h2>
                        </div>
                    </div>

                    <!-- Navigation Buttons -->
                    <div class="navigation-container">
                        <div class="carousel-navigation products-navigation d-flex justify-content-end gap-2">
                            <button class="carousel-prev products-prev btn btn-outline-organic rounded-circle p-2" id="prev-featured">
                                <i class="bi bi-chevron-left"/>
                            </button>
                            <button class="carousel-next products-next btn btn-outline-organic rounded-circle p-2" id="next-featured">
                                <i class="bi bi-chevron-right"/>
                            </button>
                        </div>
                    </div>

                    <!-- Fetch Featured Products -->
                    <t t-set="featured" t-value="request.env['featured.products'].sudo().search([], limit=1)"/>
                    <t t-set="featured_products" t-value="featured.product_tmpl_ids"/>

                    <!-- Swiper Container -->
                    <div class="swiper carousel-swiper products-swiper" id="swiper-featured">
                        <div class="swiper-wrapper">

                            <t t-if="featured_products">
                                <t t-foreach="featured_products" t-as="product">
                                    <t t-set="contextual_price"
                                       t-value="(current_pricelist and product.with_context(pricelist=current_pricelist.id)._get_contextual_price()) or product._get_contextual_price()"/>
                                    <div class="swiper-slide col-6 col-md-4 col-lg-2-4">
                                        <div class="product-card shadow-hover border-0">

                                            <div class="product-card-image position-relative">
                                                <a t-att-href="'/shop/product/%s' % product.id">
                                                    <img t-att-src="'/web/image/product.template/%s/image_512' % product.id"
                                                         t-att-alt="product.name"/>
                                                </a>
                                                <div class="product-badge bg-warning text-white fw-bold">Featured</div>

                                                <!-- Action Buttons -->
                                                <div class="product-actions position-absolute top-0 end-0 m-2 d-flex flex-column gap-1 opacity-0">
                                                    <button type="button"
                                                            class="btn btn-light btn-sm rounded-circle shadow-sm"
                                                            t-att-onclick="'event.stopPropagation(); addToWishlist(%s);' % product.id"
                                                            title="Add to Wishlist">
                                                        <i class="bi bi-heart"></i>
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-light btn-sm rounded-circle shadow-sm"
                                                            t-attf-onclick="event.preventDefault(); event.stopPropagation(); quickView(#{product.id});"
                                                            t-att-data-quick-view-product-id="product.id"
                                                            title="Quick View">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="p-3">
                                                <h6 class="fw-semibold text-dark mb-2">
                                                    <t t-esc="product.name"/>
                                                </h6>
                                                <p class="text-muted small mb-2">
                                                    <t t-esc="product.categ_id.name"/>
                                                </p>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="h6 text-danger fw-bold">
                                                        <t t-out="contextual_price"
                                                           t-options="{'widget': 'monetary', 'display_currency': display_currency}"/>
                                                    </span>
                                                    <button type="button"
                                                            class="btn btn-sm btn-organic rounded-pill s_add_to_cart_btn"
                                                            t-att-data-product-template-id="product.id"
                                                            t-att-data-product-variant-id="product._get_first_possible_variant_id()"
                                                            t-att-data-product-type="product.type"
                                                            data-action="add_to_cart"
                                                            data-show-quantity="False">
                                                        <i class="bi bi-cart3"></i> Add
                                                    </button>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </t>
                            </t>

                            <!-- Empty State -->
                            <t t-else="">
                                <div class="text-center w-100 py-5">
                                    <i class="bi bi-basket text-muted" style="font-size:3rem;"></i>
                                    <p class="text-muted mt-3">No featured products available</p>
                                </div>
                            </t>

                        </div>
                    </div>

                </div>
            </div>
        </section>



    </template>
</odoo>
