<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="naturalfood_our_products" name="Our Products Section">
        <section class="product-tabs py-5 featured-products-new-tab">
            <div class="container">
                <t t-set="current_pricelist" t-value="(request.session.get('website_sale_current_pl') and request.env['product.pricelist'].sudo().browse(int(request.session.get('website_sale_current_pl')))) or (website and website._get_and_cache_current_pricelist())"/>
                <t t-set="display_currency"
                   t-value="(current_pricelist and current_pricelist.currency_id) or request.env.company.currency_id"/>
                <t t-set="categories" t-value="request.env['product.public.category'].sudo().search([], order='sequence asc')"/>
                <t t-set="first_category" t-value="categories[:1] and categories[0] or False"/>
                <t t-set="first_cat_product"
                   t-value="first_category and request.env['product.template'].sudo().search([('public_categ_ids', 'in', [first_category.id]), ('is_published', '=', True)], limit=1) or False"/>
                <t t-set="first_image_src"
                   t-value="('/web/image/product.public.category/%s/image_128' % first_category.id) if (first_category and first_category.image_128) else (('/web/image/product.template/%s/image_512' % first_cat_product.id) if first_cat_product else '')"/>

                <!-- Header with title on left, tabs on right -->
                <div class="row align-items-center justify-content-between mb-5">
                    <div class="col-lg-6">
                        <h2 class="h2 fw-bold text-dark mb-2">Our Products</h2>
                    </div>
                    <div class="col-lg-6 text-lg-end">
                        <!-- Tab Navigation Pills - Right Aligned -->
                        <div class="btn-group bg-white rounded-pill shadow-sm p-2 gap-3 align-items-center"
                             role="group"
                             aria-label="Product categories">

                            <!--  Tabs — product.public.category -->
                            <t t-set="category_first" t-value="True"/>
                            <t t-foreach="categories" t-as="category">
                                <t t-set="cat_product"
                                   t-value="request.env['product.template'].sudo().search([('public_categ_ids', 'in', [category.id]), ('is_published', '=', True)], limit=1)"/>
                                <input type="radio"
                                       class="btn-check category-tab"
                                       name="productTabs"
                                       t-att-id="'tab-%s' % category.id"
                                       t-att-data-category="category.id"
                                       t-att-data-image-src="('/web/image/product.public.category/%s/image_128' % category.id) if category.image_128 else (('/web/image/product.template/%s/image_512' % cat_product.id) if cat_product else '')"
                                       t-att-data-image-alt="category.name"
                                       autocomplete="off"
                                       t-att-checked="'checked' if category_first else None"/>
                                <label class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold text-dark"
                                       t-att-for="'tab-%s' % category.id">
                                    <t t-esc="category.name"/>
                                </label>
                                <t t-set="category_first" t-value="False"/>
                            </t>

                        </div>
                    </div>
                </div>

                <!-- Content Layout: Left Image + Right Slider -->
                <div class="row g-4">

                    <!-- Left Side Image -->
                    <div class="col-lg-3">
                        <div class="position-relative rounded-3 overflow-hidden shadow-lg" style="height: 320px">
                            <img id="category-image"
                                 t-att-src="first_image_src"
                                 t-att-alt="first_category and first_category.name or 'Category Image'"
                                 class="w-100 h-100 object-fit-cover transition-all"/>
                        </div>
                    </div>

                    <!-- Right Side Product Slider - 4 products per slide -->
                    <div class="col-lg-9">

                        <!-- Slider Controls -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <small class="text-muted" id="slide-info">Slide 1 of 1</small>
                            <div class="btn-group gap-2" role="group">
                                <button type="button" class="btn btn-outline-secondary btn-sm rounded-circle" id="prev-slide">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm rounded-circle" id="next-slide">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Product Grid Container -->
                        <div id="product-slider" class="row g-4">
                            <t t-set="slider_first" t-value="True"/>

                            <t t-foreach="categories" t-as="category">

                                <t t-set="cat_products"
                                   t-value="request.env['product.template'].sudo().search([
                   ('public_categ_ids', 'in', [category.id]),
                   ('is_published', '=', True),
                   ('sale_ok', '=', True),
               ], limit=8)"/>

                                <!-- Swiper -->
                                <div class="swiper category-products"
                                     t-att-data-category="category.id"
                                     t-att-style="'display:block;' if slider_first else 'display:none;'">

                                    <div class="swiper-wrapper">

                                        <t t-foreach="cat_products" t-as="product">
                                            <div class="swiper-slide">
                                                <div class="product-card shadow-hover border-0">
                                                    <t t-set="contextual_price"
                                                       t-value="(current_pricelist and product.with_context(pricelist=current_pricelist.id)._get_contextual_price()) or product._get_contextual_price()"/>

                                                    <div class="product-card-image position-relative">
                                                        <a t-att-href="'/shop/%s' % slug(product)">
                                                            <img t-att-src="'/web/image/product.template/%s/image_512' % product.id"
                                                                 t-att-alt="product.name"
                                                                 class="img-fluid w-100"/>
                                                        </a>

                                                        <!-- Action Buttons -->
                                                        <div class="product-actions position-absolute top-0 end-0 m-2 d-flex flex-column gap-1 opacity-0">
                                                            <button type="button"
                                                                    class="btn btn-light btn-sm rounded-circle shadow-sm"
                                                                    t-att-onclick="'event.stopPropagation(); addToWishlist(%s);' % product.id"
                                                                    title="Add to Wishlist">
                                                                <i class="bi bi-heart"></i>
                                                            </button>
                                                            <button type="button"
                                                                    class="btn btn-light btn-sm rounded-circle shadow-sm"
                                                                    t-att-onclick="'event.stopPropagation(); quickView(%s);' % product.id"
                                                                    title="Quick View">
                                                                <i class="bi bi-eye"></i>
                                                            </button>
                                                        </div>
                                                    </div>

                                                    <div class="p-3">
                                                        <h6 class="fw-semibold text-dark mb-2">
                                                            <t t-esc="product.name"/>
                                                        </h6>

                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <span class="h6 text-organic-600 fw-bold">
                                                                <t t-out="contextual_price"
                                                                   t-options="{'widget': 'monetary', 'display_currency': display_currency}"/>
                                                            </span>

                                                            <button type="button"
                                                                    class="btn btn-sm btn-organic rounded-pill s_add_to_cart_btn"
                                                                    t-att-data-product-template-id="product.id"
                                                                    t-att-data-product-variant-id="product.product_variant_id.id"
                                                                    t-att-data-product-type="product.type"
                                                                    data-action="add_to_cart"
                                                                    data-show-quantity="False">
                                                                <i class="bi bi-cart3"/>
                                                                Add
                                                            </button>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </t>

                                    </div>
                                </div>
                                <t t-set="slider_first" t-value="False"/>

                            </t>
                        </div>

                    </div>

                </div>
            </div>
        </section>
    </template>
</odoo>