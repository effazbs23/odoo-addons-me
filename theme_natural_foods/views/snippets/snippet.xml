<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="naturalfood_banner_snippet" inherit_id="website.snippets" name="Natural Food ">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t t-snippet="theme_natural_foods.naturalfood_banner" snippet-group="naturalfood_snippet"
               string="Natural Foods Snippet"
               t-thumbnail="/theme_natural_foods/static/src/img/banner.jpg"/>


        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_natural_foods.naturalfood_banner" string="Food Banner - Image" group="naturalfood_snippet"/>

            <t t-snippet="theme_natural_foods.naturalfood_new_arrival" string="New Arrival - Image"
               group="naturalfood_snippet"/>

            <t t-snippet="theme_natural_foods.naturalfood_shop_by_category" string="Shop by category"
               group="naturalfood_snippet"/>

            <t t-snippet="theme_natural_foods.naturalfood_promo_banners"
               string="Promo Banners"
               group="naturalfood_snippet"/>

            <t t-snippet="theme_natural_foods.naturalfood_deals_of_the_day"
               string="Deals of the Day"
               group="naturalfood_snippet"/>

            <t t-snippet="theme_natural_foods.naturalfood_two_banners"
               string="Two Banners"
               group="naturalfood_snippet"/>


            <t t-snippet="theme_natural_foods.naturalfood_our_products"
               string="Our Products"
               group="naturalfood_snippet"/>

            <t t-snippet="theme_natural_foods.naturalfood_promo_banner_new"
               string="Promo Banner New"
               group="naturalfood_snippet"/>

            <t t-snippet="theme_natural_foods.naturalfood_our_brands"
               string="Our Brands"
               group="naturalfood_snippet"/>

            <t t-snippet="theme_natural_foods.naturalfood_service_features"
               string="Service Features"
               group="naturalfood_snippet"/>

            <t t-snippet="theme_natural_foods.naturalfood_newsletter"
               string="Newsletter"
               group="naturalfood_snippet"/>

            <t t-snippet="theme_natural_foods.best_seller_snippet"
               string="Best Seller"
               group="naturalfood_snippet"/>

            <t t-snippet="theme_natural_foods.featured_products_snippet"
               string="Featured Products"
               group="naturalfood_snippet"/>

            <t t-snippet="theme_natural_foods.featured_recipes_snippet"
               string="Featured Recipes"
               group="naturalfood_snippet"/>

        </xpath>


    </template>
</odoo>